<?xml version="1.0" standalone="yes"?>

<!--       by Alexei J. Drummond, Andrew Rambaut and Marc A. Suchard         -->
<!--       Department of Computer Science, University of Auckland and        -->
<!--       Institute of Evolutionary Biology, University of Edinburgh        -->
<!--       David Geffen School of Medicine, University of California, Los Angeles-->
<!--       http://beast.community/                                           -->
<beast>
	

	<!-- The list of taxa to be analysed (can also include dates/ages).          -->
	<!-- ntax=17                                                                 -->
	<taxa id="taxa">
		<taxon id="D4Brazi82">
			<date value="1982.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4ElSal83">
			<date value="1983.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4ElSal94">
			<date value="1994.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Indon76">
			<date value="1976.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Indon77">
			<date value="1977.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Mexico84">
			<date value="1984.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4NewCal81">
			<date value="1981.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Philip64">
			<date value="1964.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Philip56">
			<date value="1956.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Philip84">
			<date value="1984.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4PRico86">
			<date value="1986.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4SLanka78">
			<date value="1978.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Tahiti79">
			<date value="1979.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Tahiti85">
			<date value="1985.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Thai63">
			<date value="1963.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Thai78">
			<date value="1978.0" direction="forwards" units="years"/>
		</taxon>
		<taxon id="D4Thai84">
			<date value="1984.0" direction="forwards" units="years"/>
		</taxon>
	</taxa>
	
	

	<!-- The sequence alignment (each sequence refers to a taxon above).         -->
	<!-- ntax=17 nchar=1485                                                      -->
	<alignment id="alignment" dataType="nucleotide">
		<sequence>
			<taxon idref="D4Brazi82"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4ElSal83"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4ElSal94"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Indon76"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Indon77"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Mexico84"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4NewCal81"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Philip64"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Philip56"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Philip84"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4PRico86"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4SLanka78"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Tahiti79"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Tahiti85"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Thai63"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Thai78"/>
			
		</sequence>
		<sequence>
			<taxon idref="D4Thai84"/>
			
		</sequence>
	</alignment>
	
	

	<!-- The unique patterns from 1 to end                                       -->
	<!-- npatterns=138                                                           -->
	<patterns id="patterns" from="1" strip="false">
		<alignment idref="alignment"/>
	</patterns>
	

	<!-- A prior assumption that the population size has remained constant       -->
	<!-- throughout the time spanned by the genealogy.                           -->
	<constantSize id="constant" units="years">
		<populationSize>
			<parameter id="constant.popSize" value="1.0" lower="0.0"/>
		</populationSize>
	</constantSize>
	

	<!-- Construct a starting tree that is compatible with specified clade heights-->
	<rescaledTree id="startingTree">

		<!-- Construct a rough-and-ready UPGMA tree as an starting tree              -->
		<upgmaTree>
			<distanceMatrix correction="JC">
				<patterns>

					<!-- To generate UPGMA starting tree, only use the 1st aligment, which may be 1 of many aligments using this tree.-->
					<alignment idref="alignment"/>
				</patterns>
			</distanceMatrix>
		</upgmaTree>
	</rescaledTree>
	

	<!-- Generate a tree model                                                   -->
	<treeModel id="treeModel">
		<upgmaTree idref="startingTree"/>
		<rootHeight>
			<parameter id="treeModel.rootHeight"/>
		</rootHeight>
		<nodeHeights internalNodes="true">
			<parameter id="treeModel.internalNodeHeights"/>
		</nodeHeights>
		<nodeHeights internalNodes="true" rootNode="true">
			<parameter id="treeModel.allInternalNodeHeights"/>
		</nodeHeights>
	</treeModel>

	<!-- Statistic for height of the root of the tree                            -->
	<treeHeightStatistic id="rootHeight">
		<treeModel idref="treeModel"/>
	</treeHeightStatistic>

	<!-- Statistic for sum of the branch lengths of the tree (tree length)       -->
	<treeLengthStatistic id="treeLength">
		<treeModel idref="treeModel"/>
	</treeLengthStatistic>
	

	<!-- Generate a coalescent likelihood                                        -->
	<coalescentLikelihood id="coalescent">
		<model>
			<constantSize idref="constant"/>
		</model>
		<intervals>
			<treeIntervals>
				<treeModel idref="treeModel"/>
			</treeIntervals>
		</intervals>
	</coalescentLikelihood>
	

	<!-- The strict clock (Uniform rates across branches)                        -->
	<strictClockBranchRates id="branchRates">
		<rate>
			<parameter id="clock.rate" value="0.001" lower="0.0"/>
		</rate>
	</strictClockBranchRates>
	
	<rateStatistic id="meanRate" name="meanRate" mode="mean" internal="true" external="true">
		<treeModel idref="treeModel"/>
		<strictClockBranchRates idref="branchRates"/>
	</rateStatistic>
	

	<!-- The HKY substitution model (Hasegawa, Kishino & Yano, 1985)             -->
	<HKYModel id="hky">
		<frequencies>
			<frequencyModel dataType="nucleotide">
				<frequencies>
					<parameter id="frequencies" value="0.25 0.25 0.25 0.25"/>
				</frequencies>
			</frequencyModel>
		</frequencies>
		<kappa>
			<parameter id="kappa" value="2.0" lower="0.0"/>
		</kappa>
	</HKYModel>

	<!-- site model                                                              -->
	<siteModel id="siteModel">
		<substitutionModel>
			<HKYModel idref="hky"/>
		</substitutionModel>
	</siteModel>

	<!--                                                                         -->
	<statistic id="mu" name="mu">
		<siteModel idref="siteModel"/>
	</statistic>
	

	<!-- Likelihood for tree given sequence data                                 -->
	<treeDataLikelihood id="treeLikelihood" useAmbiguities="false" usePreOrder="true" branchInfinitesimalDerivative="true">
		<partition>
			<patterns idref="patterns"/>
			<siteModel idref="siteModel"/>
		</partition>
		<treeModel idref="treeModel"/>
		<strictClockBranchRates idref="branchRates"/>
	</treeDataLikelihood>
	

	<!-- The densities to maximize: priors, tree likelihoods and their joint     -->
	<joint id="joint">
		<prior id="prior">
			<logNormalPrior mu="1.0" sigma="1.25" offset="0.0">
				<parameter idref="kappa"/>
			</logNormalPrior>
			<dirichletPrior alpha="1.0" sumsTo="1.0">
				<parameter idref="frequencies"/>
			</dirichletPrior>
			<ctmcScalePrior>
				<ctmcScale>
					<parameter idref="clock.rate"/>
				</ctmcScale>
				<treeModel idref="treeModel"/>
			</ctmcScalePrior>
			<gammaPrior shape="0.001" scale="1000.0" offset="0.0">
				<parameter idref="constant.popSize"/>
			</gammaPrior>
			<coalescentLikelihood idref="coalescent"/>
			
			
			<strictClockBranchRates idref="branchRates"/>
		</prior>
		<likelihood id="likelihood">
			<treeDataLikelihood idref="treeLikelihood"/>
		</likelihood>
	</joint>
	

	<!-- Maximize the joint density by L-BFGS, with analytic tree-likelihood gradients for 2 of 3 parameters; 1 set(s) of frequencies on the simplex, with analytic gradients-->
	<!-- The topology is searched (timeTreeSearch below); the internal node heights are optimized as ratios on the real line-->
	<compoundParameter id="optimizedParameters">
		<parameter idref="kappa"/>
		<parameter idref="clock.rate"/>
		<parameter idref="constant.popSize"/>
	</compoundParameter>
	

	<!-- Gradient blocks, one per optimized parameter, in the order of optimizedParameters-->
	<jointGradient id="gradient.kappa">
		<numericalGradient>
			<prior idref="prior"/>
			<parameter idref="kappa"/>
		</numericalGradient>
		<branchSubstitutionParameterGradient homogeneous="true">
			<treeDataLikelihood idref="treeLikelihood"/>
			<parameter idref="kappa"/>
		</branchSubstitutionParameterGradient>
	</jointGradient>
	<jointGradient id="gradient.clock.rate">
		<numericalGradient>
			<prior idref="prior"/>
			<parameter idref="clock.rate"/>
		</numericalGradient>
		<branchRateGradient traitName="Sequence">
			<treeDataLikelihood idref="treeLikelihood"/>
		</branchRateGradient>
	</jointGradient>
	<numericalGradient id="gradient.constant.popSize">
		<prior idref="prior"/>
		<parameter idref="constant.popSize"/>
	</numericalGradient>
	
	<branchSubstitutionParameterGradient id="gradient.frequencies" homogeneous="true">
		<treeDataLikelihood idref="treeLikelihood"/>
		<parameter idref="frequencies"/>
	</branchSubstitutionParameterGradient>

	<!-- The internal node heights of treeModel: root and internal nodes, mapped to the real line through ratios-->
	<nodeHeightProxyParameter id="nodeHeights" rootNode="true">
		<treeModel idref="treeModel"/>
	</nodeHeightProxyParameter>
	<nodeHeightTransform id="nodeHeightTransform" withRoot="true">
		<treeModel idref="treeModel"/>
		<strictClockBranchRates idref="branchRates"/>
		<ratios realLine="true">
			<parameter id="nodeHeight.ratios"/>
		</ratios>
	</nodeHeightTransform>
	<jointGradient id="gradient.nodeHeights">
		<coalescentGradient>
			<coalescentLikelihood idref="coalescent"/>
			<treeModel idref="treeModel"/>
		</coalescentGradient>
		<ctmcScalePriorNodeHeightGradient>
			<ctmcScalePrior id="clock.rate.nodeHeightPrior">
				<ctmcScale>
					<parameter idref="clock.rate"/>
				</ctmcScale>
				<treeModel idref="treeModel"/>
			</ctmcScalePrior>
			<treeModel idref="treeModel"/>
		</ctmcScalePriorNodeHeightGradient>
		<nodeHeightGradient traitName="Sequence">
			<treeDataLikelihood idref="treeLikelihood"/>
		</nodeHeightGradient>
	</jointGradient>
	
	<compoundGradient id="maximizerGradient">
		<jointGradient idref="gradient.kappa"/>
		<jointGradient idref="gradient.clock.rate"/>
		<numericalGradient idref="gradient.constant.popSize"/>
		<branchSubstitutionParameterGradient idref="gradient.frequencies"/>
		<jointGradient idref="gradient.nodeHeights"/>
	</compoundGradient>
	
	<maximizeWrtParameter id="maximizer" maximizeOnParse="false" nIterations="1000" startAtCurrentState="true" printToScreen="true" includeJacobian="false" lineSearchRestarts="5" past="10" delta="1.0E-8">
		<objective>
			<joint idref="joint"/>
		</objective>
		<compoundGradient idref="maximizerGradient"/>
		<multivariateCompoundTransform>
			<compoundTransform>
				<transform type="log">
					<parameter idref="kappa"/>
					<parameter idref="clock.rate"/>
					<parameter idref="constant.popSize"/>
				</transform>
				<compoundParameter idref="optimizedParameters"/>
			</compoundTransform>
			<UnitSimplexTransform dimension="4"/>
			<nodeHeightTransform idref="nodeHeightTransform"/>
		</multivariateCompoundTransform>
	</maximizeWrtParameter>
	

	<!-- The topology search's round re-fits: node heights and branch rates only, from the maximizer's gradient blocks-->
	<compoundParameter id="searchRates">
		<parameter idref="clock.rate"/>
	</compoundParameter>
	<compoundGradient id="searchGradient">
		<jointGradient idref="gradient.clock.rate"/>
		<jointGradient idref="gradient.nodeHeights"/>
	</compoundGradient>
	
	<maximizeWrtParameter id="roundMaximizer" maximizeOnParse="false" nIterations="200" startAtCurrentState="true" printToScreen="false" includeJacobian="false" lineSearchRestarts="5" past="10" delta="1.0E-8">
		<objective>
			<joint idref="joint"/>
		</objective>
		<compoundGradient idref="searchGradient"/>
		<multivariateCompoundTransform>
			<compoundTransform>
				<transform type="log">
					<parameter idref="clock.rate"/>
				</transform>
				<compoundParameter idref="searchRates"/>
			</compoundTransform>
			<nodeHeightTransform idref="nodeHeightTransform"/>
		</multivariateCompoundTransform>
	</maximizeWrtParameter>
	

	<!-- Search the topology by rooted NNIs from the starting tree; a move is kept only when the joint density rises-->
	<!-- The best tree: golden.search.trees; one row per round: golden.search.log-->
	<timeTreeSearch id="treeSearch" seed="1" printToScreen="true" treeFileName="golden.search.trees" logFileName="golden.search.log">
		<treeModel idref="treeModel"/>
		<objective>
			<joint idref="joint"/>
		</objective>
		<roundMaximizer>
			<maximizeWrtParameter idref="roundMaximizer"/>
		</roundMaximizer>
		<finalMaximizer>
			<maximizeWrtParameter idref="maximizer"/>
		</finalMaximizer>
	</timeTreeSearch>
	

	<!-- The optimum, the gradient there, and why the maximizer stopped          -->
	<report fileName="golden.max.txt">
		<maximizeWrtParameter idref="maximizer"/>
		<timeTreeSearch idref="treeSearch"/>
	</report>
	<report>
		<maximizeWrtParameter idref="maximizer"/>
		<timeTreeSearch idref="treeSearch"/>
	</report>
	

	<!-- The trees at the optimum, logged once by timeTreeExport                 -->
	<logTree id="timeTreeLog" logEvery="1" nexusFormat="true" sortTranslationTable="true" fileName="golden.timetree.nex">
		<treeModel idref="treeModel"/>
		<strictClockBranchRates idref="branchRates"/>
		<joint idref="joint"/>
	</logTree>
	<logTree id="substTreeLog" logEvery="1" nexusFormat="true" sortTranslationTable="true" fileName="golden.subst.nex" branchLengths="substitutions">
		<treeModel idref="treeModel"/>
		<strictClockBranchRates idref="branchRates"/>
		<joint idref="joint"/>
	</logTree>
	

	<!-- Log the trees; the dates and rates, the parameters and a record of the run-->
	<timeTreeExport id="timeTreeExport" fileNameStem="golden">
		<logTree idref="timeTreeLog"/>
		<logTree idref="substTreeLog"/>
		<maximizeWrtParameter idref="maximizer"/>
		<treeLikelihoods>
			<likelihood idref="likelihood"/>
		</treeLikelihoods>
		<priors>
			<prior idref="prior"/>
		</priors>
		<timeTree>
			<treeModel idref="treeModel"/>
			<strictClockBranchRates idref="branchRates"/>
		</timeTree>
	</timeTreeExport>
	
</beast>

