<?xml version="1.0" standalone="yes"?>
<!-- Gradient of the CTMC rate reference prior (BEAUti's default clock.rate prior) wrt internal node heights, which -->
<!-- enter through the tree length. Each report also checks the analytic gradient against finite differences.     -->
<beast>
  <taxa id="taxa">
    <taxon id="A"/><taxon id="B"/><taxon id="C"/><taxon id="D"/><taxon id="E"/>
  </taxa>
  <newick id="startingTree">((A:0.12,B:0.12):0.31,(C:0.25,(D:0.07,E:0.07):0.18):0.18);</newick>
  <treeModel id="treeModel">
    <tree idref="startingTree"/>
    <rootHeight><parameter id="treeModel.rootHeight"/></rootHeight>
    <nodeHeights internalNodes="true"><parameter id="treeModel.internalNodeHeights"/></nodeHeights>
    <nodeHeights internalNodes="true" rootNode="true"><parameter id="treeModel.allInternalNodeHeights"/></nodeHeights>
  </treeModel>
  <parameter id="clock.rate" value="0.8" lower="0.0"/>

  <ctmcScalePrior id="clock.rate.prior">
    <ctmcScale><parameter idref="clock.rate"/></ctmcScale>
    <treeModel idref="treeModel"/>
  </ctmcScalePrior>
  <ctmcScalePriorNodeHeightGradient id="gradient.ctmcScalePrior.nodeHeights">
    <ctmcScalePrior idref="clock.rate.prior"/>
    <treeModel idref="treeModel"/>
  </ctmcScalePriorNodeHeightGradient>

  <cachedReport id="report.ctmcScalePrior.nodeHeights">
    <report><ctmcScalePriorNodeHeightGradient idref="gradient.ctmcScalePrior.nodeHeights"/></report>
  </cachedReport>
  <!-- T = 1.3, so d log L / dT = 0.5 / T - rate = -0.4153846...; the root has two counted child branches -->
  <assertEqual tolerance="1E-10" verbose="true" charactersToStrip="\[\],">
    <message>analytic gradient (CTMC reference prior, node heights)</message>
    <actual regex="analytic: (.*?)\n"><cachedReport idref="report.ctmcScalePrior.nodeHeights"/></actual>
    <expected>-0.41538461538461546 -0.41538461538461546 -0.41538461538461546 -0.8307692307692309</expected>
  </assertEqual>
</beast>
