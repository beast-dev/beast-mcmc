<?xml version="1.0" standalone="yes"?>
<beast version="10.5.0-beta4">

    <taxa id="taxa">
        <taxon id="A"><attr name="X">0.0</attr></taxon>
        <taxon id="B"><attr name="X">0.8</attr></taxon>
        <taxon id="C"><attr name="X">-0.4</attr></taxon>
    </taxa>

    <newick id="tree" usingHeights="true" usingDates="false">
        ((A:1.0,B:1.0):1.0,C:2.0);
    </newick>

    <treeModel id="treeModel" fixHeights="true">
        <tree idref="tree"/>
        <rootHeight>
            <parameter id="treeModel.rootHeight"/>
        </rootHeight>
        <nodeHeights internalNodes="true">
            <parameter id="treeModel.internalNodeHeights"/>
        </nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true">
            <parameter id="treeModel.allInternalNodeHeights"/>
        </nodeHeights>
        <nodeTraits name="X" rootNode="false" internalNodes="false" leafNodes="true" traitDimension="1">
            <parameter id="observed.X"/>
        </nodeTraits>
    </treeModel>

    <compoundParameter id="rewardRates.values">
        <parameter id="rewardRates.fixedValues" dimension="2" value="0 1" lower="0.0" upper="1.0"/>
        <parameter id="rewardRates.varyingValues" dimension="2" value="0.25 0.75" lower="0.0" upper="1.0"/>
    </compoundParameter>
    <parameter id="rewardRates.stateIndices" dimension="4" value="0 2 3 1" lower="0" upper="3"/>

    <rewardRates id="rewardRates">
        <fixedValues>
            <parameter idref="rewardRates.fixedValues"/>
        </fixedValues>
        <varyingValues>
            <parameter idref="rewardRates.varyingValues"/>
        </varyingValues>
        <stateIndices>
            <parameter idref="rewardRates.stateIndices"/>
        </stateIndices>
    </rewardRates>

    <parameter id="total.rewards.cts" dimension="4" value="0.2 0.4 0.6 0.8" lower="0.0" upper="1.0"/>
    <parameter id="bernoulliVar" dimension="4" value="0 1 0 1" lower="0" upper="1"/>
    <parameter id="atomIndex" dimension="4" value="0 1 2 3" lower="0" upper="3"/>

    <rewardsAwareMixtureBranchRates id="rewardBranchRates" linearLocationScale="true">
        <atomic>
            <atomIndices>
                <parameter idref="atomIndex"/>
            </atomIndices>
            <rewardRates idref="rewardRates"/>
        </atomic>
        <ctsParameter>
            <parameter idref="total.rewards.cts"/>
        </ctsParameter>
        <indicator>
            <parameter idref="bernoulliVar"/>
        </indicator>
        <treeModel idref="treeModel"/>
        <scale>
            <parameter id="branchRates.scale" lower="0.0" upper="5" value="1.75"/>
        </scale>
        <location>
            <parameter id="branchRates.location" lower="0.0" upper="5" value="0.25"/>
        </location>
    </rewardsAwareMixtureBranchRates>

    <compoundParameter id="branchRates.locationScale">
        <parameter idref="branchRates.location"/>
        <parameter idref="branchRates.scale"/>
    </compoundParameter>

    <multivariateDiffusionModel id="diffusionModel">
        <precisionMatrix>
            <matrixParameter id="precisionMatrix">
                <parameter id="precision.col1" value="1.0"/>
            </matrixParameter>
        </precisionMatrix>
    </multivariateDiffusionModel>

    <traitDataLikelihood id="observedLikelihood" traitName="X"
                         forceFullPrecision="true"
                         reconstructTraits="false">
        <multivariateDiffusionModel idref="diffusionModel"/>
        <treeModel idref="treeModel"/>
        <traitParameter>
            <parameter idref="observed.X"/>
        </traitParameter>
        <rewardsAwareMixtureBranchRates idref="rewardBranchRates"/>
        <conjugateRootPrior>
            <meanParameter>
                <parameter value="0.0"/>
            </meanParameter>
            <priorSampleSize>
                <parameter value="1.0"/>
            </priorSampleSize>
        </conjugateRootPrior>
    </traitDataLikelihood>

    <continuousRewardsAwareMixtureBranchRatesLocationScaleGradient id="locationScaleGradient" traitName="X">
        <traitDataLikelihood idref="observedLikelihood"/>
        <rewardsAwareMixtureBranchRates idref="rewardBranchRates"/>
        <compoundParameter idref="branchRates.locationScale"/>
    </continuousRewardsAwareMixtureBranchRatesLocationScaleGradient>

    <continuousRewardsAwareMixtureBranchRatesRewardRateGradient id="rewardRateGradient" traitName="X">
        <traitDataLikelihood idref="observedLikelihood"/>
        <rewardsAwareMixtureBranchRates idref="rewardBranchRates"/>
        <rewardRates idref="rewardRates"/>
    </continuousRewardsAwareMixtureBranchRatesRewardRateGradient>

    <compoundGradient id="locationScaleRewardRatesGradient">
        <continuousRewardsAwareMixtureBranchRatesLocationScaleGradient idref="locationScaleGradient"/>
        <continuousRewardsAwareMixtureBranchRatesRewardRateGradient idref="rewardRateGradient"/>
    </compoundGradient>

    <operators id="operators">
        <hamiltonianMonteCarloOperator id="locationScaleRewardRatesHMC" weight="1.0"
                                       nSteps="2" stepSize="1E-3"
                                       mode="vanilla" autoOptimize="false"
                                       gradientCheckCount="1"
                                       gradientCheckTolerance="1E-4">
            <compoundGradient idref="locationScaleRewardRatesGradient"/>
            <compoundParameter id="locationScaleRewardRates">
                <parameter idref="branchRates.location"/>
                <parameter idref="branchRates.scale"/>
                <parameter idref="rewardRates.varyingValues"/>
            </compoundParameter>
            <multivariateCompoundTransform>
                <transform type="log" dim="2"/>
                <transform type="logit" dim="2"/>
            </multivariateCompoundTransform>
        </hamiltonianMonteCarloOperator>
    </operators>

    <mcmc id="mcmc" chainLength="2" autoOptimize="false">
        <joint id="joint">
            <prior id="prior"/>
            <likelihood id="likelihood">
                <traitDataLikelihood idref="observedLikelihood"/>
            </likelihood>
        </joint>
        <operators idref="operators"/>
        <log id="screenLog" logEvery="1">
            <joint idref="joint"/>
            <traitDataLikelihood idref="observedLikelihood"/>
            <parameter idref="branchRates.location"/>
            <parameter idref="branchRates.scale"/>
            <parameter idref="rewardRates.varyingValues"/>
        </log>
    </mcmc>

</beast>
