<?xml version="1.0" standalone="yes"?>
<!-- Analytic frequency gradient for HKY+F (plan 5, FQ6). Literals from the b1 oracle:              -->
<!-- 5 taxa, 44 sites, HKY kappa=2.5, pi=(0.1,0.2,0.3,0.4), strict clock 1.0; without rate         -->
<!-- heterogeneity and with a 4-category discrete Gamma (alpha=0.5).                                -->
<!-- Every scaling scheme, both backends and the spectral representation must agree.              -->
<beast>
  <taxa id="taxa">
    <taxon id="A"/>
    <taxon id="B"/>
    <taxon id="C"/>
    <taxon id="D"/>
    <taxon id="E"/>
  </taxa>
  <alignment id="alignment" dataType="nucleotide">
    <sequence><taxon idref="A"/>AAAAAACCCCGGGGGTTTTTTTAACAAAGTTACGARACCCGGTA</sequence>
    <sequence><taxon idref="B"/>AAAAAACCCCGGGGGTTTTTTTAACGGCGTTATATAACCCGGCC</sequence>
    <sequence><taxon idref="C"/>AAAAAACCCCGGGGGTTTTTTTGGTAAGGCCACGAA-CCCAATC</sequence>
    <sequence><taxon idref="D"/>AAAAAACCCCGGGGGTTTTTTTGGTAATATTATATGGCCCGGCC</sequence>
    <sequence><taxon idref="E"/>AAAAAACCCCGGGGGTTTTTTTGGTAAAATTGCGAGGTTTGGCA</sequence>
  </alignment>
  <patterns id="patterns" from="1">
    <alignment idref="alignment"/>
  </patterns>
  <newick id="startingTree">
    ((A:0.12,B:0.12):0.31,(C:0.25,(D:0.07,E:0.07):0.18):0.18);
  </newick>
  <treeModel id="treeModel">
    <tree idref="startingTree"/>
    <rootHeight><parameter id="treeModel.rootHeight"/></rootHeight>
    <nodeHeights internalNodes="true"><parameter id="treeModel.internalNodeHeights"/></nodeHeights>
    <nodeHeights internalNodes="true" rootNode="true"><parameter id="treeModel.allInternalNodeHeights"/></nodeHeights>
  </treeModel>
  <strictClockBranchRates id="branchRates">
    <rate><parameter id="clock.rate" value="1.0" lower="0.0"/></rate>
  </strictClockBranchRates>
  <hkyModel id="hky">
    <frequencies>
      <frequencyModel id="freqModel" dataType="nucleotide">
        <frequencies><parameter id="frequencies" value="0.1 0.2 0.3 0.4"/></frequencies>
      </frequencyModel>
    </frequencies>
    <kappa><parameter id="kappa" value="2.5" lower="0.0"/></kappa>
  </hkyModel>
  <siteModel id="siteModel">
    <substitutionModel><hkyModel idref="hky"/></substitutionModel>
  </siteModel>
  <siteModel id="siteModel.gamma4">
    <substitutionModel><hkyModel idref="hky"/></substitutionModel>
    <gammaShape gammaCategories="4"><parameter id="alpha" value="0.5" lower="0.0"/></gammaShape>
  </siteModel>

  <treeDataLikelihood id="likelihood.never" useAmbiguities="true" usePreOrder="true"
                      branchInfinitesimalDerivative="true" scalingScheme="never" delayScaling="false">
    <patterns idref="patterns"/>
    <treeModel idref="treeModel"/>
    <siteModel idref="siteModel"/>
    <strictClockBranchRates idref="branchRates"/>
  </treeDataLikelihood>
  <assertEqual tolerance="1E-12" verbose="true">
    <message>log likelihood (never)</message>
    <actual regex="likelihood:\s+(.*)\n">
      <likelihood><treeDataLikelihood idref="likelihood.never"/></likelihood>
    </actual>
    <expected>-199.92530790255657</expected>
  </assertEqual>
  <branchSubstitutionParameterGradient id="pi.never.adjoint" homogeneous="true" backend="adjoint">
    <treeDataLikelihood idref="likelihood.never"/>
    <parameter idref="frequencies"/>
  </branchSubstitutionParameterGradient>
  <cachedReport id="report.pi.never.adjoint">
    <report><branchSubstitutionParameterGradient idref="pi.never.adjoint"/></report>
  </cachedReport>
  <assertEqual tolerance="1E-8" verbose="true" charactersToStrip="\[\],">
    <message>raw gradient (never, adjoint)</message>
    <actual regex="analytic \(raw, extension-dependent, unchecked\): (.*?)\n"><cachedReport idref="report.pi.never.adjoint"/></actual>
    <expected>235.22167008314318 84.85238629502152 35.127571038937155 33.032983209138834</expected>
  </assertEqual>
  <assertEqual tolerance="1E-8" verbose="true" charactersToStrip="\[\],">
    <message>branch term (never, adjoint)</message>
    <actual regex="branch: (.*?)\n"><cachedReport idref="report.pi.never.adjoint"/></actual>
    <expected>102.7505173452081 35.31888747569713 -0.16840513201008855 7.38950293149526</expected>
  </assertEqual>
  <assertEqual tolerance="1E-10" verbose="true">
    <message>pi.root equals the site count (never, adjoint)</message>
    <actual regex="pi.root: (.*?)\n"><cachedReport idref="report.pi.never.adjoint"/></actual>
    <expected>44</expected>
  </assertEqual>
  <assertEqual tolerance="1E-8" verbose="true" charactersToStrip="\[\],">
    <message>tangent gradient (never, adjoint)</message>
