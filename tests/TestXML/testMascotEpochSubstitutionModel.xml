<?xml version="1.0" standalone="yes"?>
<beast>

    <!--
        Parser/gradient smoke test for time-varying, SubstitutionModel-backed
        MASCOT migration rates: <migrationModel> now takes one
        complexSubstitutionModel per epoch (previously exactly one, constant
        through time) when there is more than one child. Two epochs, split at
        gridPoints="1.5" (root height 3.0), each with its own
        complexSubstitutionModel and independent rates/frequencies parameters.
        migrationRates exposes both epochs' rates concatenated as one
        CompoundParameter (MascotDynamics.getMigrationModelRatesParameter());
        the gradient report below checks that against MascotCore's analytic
        adjoint the same way testMascotComplexSubstitutionModel.xml does for
        the single-epoch case.
    -->

    <taxa id="taxa">
        <taxon id="A"><attr name="state">0</attr></taxon>
        <taxon id="B"><attr name="state">1</attr></taxon>
        <taxon id="C"><attr name="state">2</attr></taxon>
        <taxon id="D"><attr name="state">0</attr></taxon>
        <taxon id="E"><attr name="state">1</attr></taxon>
        <taxon id="F"><attr name="state">2</attr></taxon>
    </taxa>

    <generalDataType id="mascot.dataType">
        <state code="0"/>
        <state code="1"/>
        <state code="2"/>
    </generalDataType>

    <attributePatterns id="tipPatterns" attribute="state">
        <taxa idref="taxa"/>
        <generalDataType idref="mascot.dataType"/>
    </attributePatterns>

    <newick id="startingTree">
        (((A:1.0,B:1.0):1.0,(C:1.0,D:1.0):1.0):1.0,(E:2.0,F:2.0):1.0);
    </newick>

    <treeModel id="treeModel">
        <tree idref="startingTree"/>
        <rootHeight>
            <parameter id="treeModel.rootHeight"/>
        </rootHeight>
        <nodeHeights internalNodes="true">
            <parameter id="treeModel.internalNodeHeights"/>
        </nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true">
            <parameter id="treeModel.allInternalNodeHeights"/>
        </nodeHeights>
    </treeModel>

    <parameter id="gridPoints" value="1.5"/>

    <complexSubstitutionModel id="location.model.epoch0" randomizeIndicator="false"
                              normalized="false" scaleRatesByFrequencies="false"
                              checkConditioning="false">
        <generalDataType idref="mascot.dataType"/>
        <frequencies>
            <frequencyModel id="location.frequencyModel.epoch0" normalize="true">
                <generalDataType idref="mascot.dataType"/>
                <frequencies>
                    <parameter id="location.frequencies.epoch0" value="1.0 1.0 1.0" dimension="3"/>
                </frequencies>
            </frequencyModel>
        </frequencies>
        <rates>
            <parameter id="location.rates.epoch0" value="0.11 0.23 0.17 0.31 0.29 0.37"
                       dimension="6" lower="0.0"/>
        </rates>
    </complexSubstitutionModel>

    <complexSubstitutionModel id="location.model.epoch1" randomizeIndicator="false"
                              normalized="false" scaleRatesByFrequencies="false"
                              checkConditioning="false">
        <generalDataType idref="mascot.dataType"/>
        <frequencies>
            <frequencyModel id="location.frequencyModel.epoch1" normalize="true">
                <generalDataType idref="mascot.dataType"/>
                <frequencies>
                    <parameter id="location.frequencies.epoch1" value="1.0 1.0 1.0" dimension="3"/>
                </frequencies>
            </frequencyModel>
        </frequencies>
        <rates>
            <parameter id="location.rates.epoch1" value="0.53 0.19 0.41 0.13 0.47 0.23"
                       dimension="6" lower="0.0"/>
        </rates>
    </complexSubstitutionModel>

    <parameter id="popSizes" value="0.1823215567939546 0.47000362924573563 0.3364722366212129
                                     0.2712193847561209 0.38512967341758213 0.4199283746519823"/>

    <structuredCoalescent type="MASCOT" id="mascotLikelihood" stateCount="3" maxStep="0.005" checkProbabilities="false">
        <treeModel idref="treeModel"/>
        <attributePatterns idref="tipPatterns"/>
        <migrationModel>
            <complexSubstitutionModel idref="location.model.epoch0"/>
            <complexSubstitutionModel idref="location.model.epoch1"/>
        </migrationModel>
        <popSizes>
            <parameter idref="popSizes"/>
        </popSizes>
        <gridPoints>
            <parameter idref="gridPoints"/>
        </gridPoints>
    </structuredCoalescent>

    <structuredCoalescentLikelihoodGradient id="mascotLikelihood.migration.grad" wrtParameter="migrationRate">
        <structuredCoalescent idref="mascotLikelihood"/>
    </structuredCoalescentLikelihoodGradient>

    <report>
        <structuredCoalescentLikelihoodGradient idref="mascotLikelihood.migration.grad"/>
    </report>

</beast>
