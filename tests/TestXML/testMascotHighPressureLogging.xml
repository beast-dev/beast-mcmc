<?xml version="1.0" standalone="yes"?>
<beast>

    <!--
        M0 regression fixture (high coalescence pressure).

        Fixed 6-tip, 3-deme tree with a long internal branch (E,F at height
        0.549, root at 5.904) and small natural-scale population sizes
        N = (0.157, 0.206, 0.032). The integrated per-lineage pressure
        R = int p.lambda dt on the (E,F) branch is about 20, so roundoff
        off the probability simplex is amplified by about e^R.

        Before M0 (origin/mascot-adjoints feca487b6), state-0 logL is
        -73.73131668 at maxStep 0.01, -73.73124037 at 0.005, -73.73132500 at
        0.001 and -73.73157454 at 0.0001: it gets worse as maxStep shrinks.
        Then validateAncestralStateScores throws "row sum 1.0000000137697787
        ... node 9" from the tree logger, and BEAST stops after state 0
        with exit status 0.

        After M0, logL should converge in maxStep to the renormalized
        reference -73.73126497724 (|delta| < 1e-8 for maxStep <= 0.001), and
        all 4 states should log without an exception.
        To vary the step: sed 's/maxStep="0.01"/maxStep="0.001"/'.
    -->

    <taxa id="taxa">
        <taxon id="A"><attr name="state">0</attr></taxon>
        <taxon id="B"><attr name="state">1</attr></taxon>
        <taxon id="C"><attr name="state">2</attr></taxon>
        <taxon id="D"><attr name="state">0</attr></taxon>
        <taxon id="E"><attr name="state">1</attr></taxon>
        <taxon id="F"><attr name="state">2</attr></taxon>
    </taxa>

    <generalDataType id="mascot.dataType">
        <state code="0"/>
        <state code="1"/>
        <state code="2"/>
    </generalDataType>

    <attributePatterns id="tipPatterns" attribute="state">
        <taxa idref="taxa"/>
        <generalDataType idref="mascot.dataType"/>
    </attributePatterns>

    <newick id="startingTree">
        (((A:2.8877280032784474,B:2.8877280032784474):1.5358558603633852,(C:3.3883756235523608,D:3.3883756235523608):1.0352082400894718):1.4805952691315536,(E:0.5493739204766552,F:0.5493739204766552):5.354805212296731);
    </newick>

    <treeModel id="treeModel">
        <tree idref="startingTree"/>
        <rootHeight>
            <parameter id="treeModel.rootHeight"/>
        </rootHeight>
        <nodeHeights internalNodes="true">
            <parameter id="treeModel.internalNodeHeights"/>
        </nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true">
            <parameter id="treeModel.allInternalNodeHeights"/>
        </nodeHeights>
    </treeModel>

    <complexSubstitutionModel id="location.model" randomizeIndicator="false"
                              normalized="false" scaleRatesByFrequencies="false"
                              checkConditioning="false">
        <generalDataType idref="mascot.dataType"/>
        <frequencies>
            <frequencyModel id="location.frequencyModel" normalize="true">
                <generalDataType idref="mascot.dataType"/>
                <frequencies>
                    <parameter id="location.frequencies" value="1.0 1.0 1.0" dimension="3"/>
                </frequencies>
            </frequencyModel>
        </frequencies>
        <rates>
            <parameter id="location.rates" value="0.022840096758276696 0.9991617072287613 0.6039584418543463 0.006329302680772018 0.6532680506509443 0.004136765472939712"
                       dimension="6" lower="0.0"/>
        </rates>
    </complexSubstitutionModel>

    <!-- natural-scale population sizes: [1.2, 1.6, 1.4] -->
    <parameter id="popSizes" value="0.15729183324413404 0.20647504338270894 0.03191953596439705"/>

    <structuredCoalescent type="MASCOT" id="mascotLikelihood" stateCount="3" maxStep="0.01" checkProbabilities="false">
        <treeModel idref="treeModel"/>
        <attributePatterns idref="tipPatterns"/>
        <migrationModel>
            <complexSubstitutionModel idref="location.model"/>
        </migrationModel>
        <popSizes>
            <parameter idref="popSizes"/>
        </popSizes>
    </structuredCoalescent>

    <operators id="operators" optimizationSchedule="log">
        <scaleOperator scaleFactor="0.9" weight="1">
            <parameter idref="location.rates"/>
        </scaleOperator>
    </operators>

    <mcmc id="mcmc" chainLength="4" autoOptimize="false">
        <posterior id="posterior">
            <likelihood id="likelihood">
                <structuredCoalescent idref="mascotLikelihood"/>
            </likelihood>
        </posterior>
        <operators idref="operators"/>
        <log id="screenLog" logEvery="1">
            <column label="posterior" dp="8" width="16">
                <posterior idref="posterior"/>
            </column>
        </log>
        <logTree id="treeFileLog" logEvery="1" nexusFormat="true" fileName="testMascotHighPressureLogging.trees">
            <structuredCoalescent idref="mascotLikelihood"/>
            <treeModel idref="treeModel"/>
        </logTree>
    </mcmc>

    <report>
        <property name="timer">
            <object idref="mcmc"/>
        </property>
    </report>

</beast>
