<?xml version="1.0" standalone="yes"?>
<beast>

    <!--
        Minimal end-to-end smoke test: a fixed 6-tip, 2-deme, single-epoch MASCOT
        likelihood sampled with Hamiltonian Monte Carlo over its migration-rate and
        population-size parameters, with BEAST's built-in analytic-vs-numeric
        gradient check enabled (gradientCheckCount/gradientCheckTolerance). The
        tree itself is fixed: no tree operators are used, only the HMC operator on
        "theta"/"popSizes".

        Migration rates ("theta") and population sizes ("popSizes") are declared as
        two separate elements (matching BASTA's <popSizes> convention), and tip
        states are declared via <attributePatterns>, resolved by taxon name, not
        a raw, tree-traversal-ordered <tipStates> parameter.

        theta/popSizes each have a weakly informative normal prior in log-space
        (standard practice for log-rates/log-sizes). mascotLikelihood exposes
        migration rates and population sizes as two independent
        GradientWrtParameterProviders (mascotGradient part="migration"/part=
        "popSizes"): each is combined with its own prior's gradient via
        jointGradient (likelihood + prior w.r.t. the same parameter), and the
        two resulting posterior-gradients are concatenated via compoundGradient
        into the one combined target the HMC operator actually moves, so
        gradientCheckCount (which differentiates joint.getLogLikelihood(), i.e.
        prior + likelihood) has something to check against on both sides. A flat
        prior let early, unadapted HMC steps wander to numerically extreme theta
        and crash the ODE integrator; this is what fixed it.
    -->

    <taxa id="taxa">
        <taxon id="A"><attr name="state">0</attr></taxon>
        <taxon id="B"><attr name="state">1</attr></taxon>
        <taxon id="C"><attr name="state">0</attr></taxon>
        <taxon id="D"><attr name="state">1</attr></taxon>
        <taxon id="E"><attr name="state">0</attr></taxon>
        <taxon id="F"><attr name="state">1</attr></taxon>
    </taxa>

    <generalDataType id="mascot.dataType">
        <state code="0"/>
        <state code="1"/>
    </generalDataType>

    <!-- tip deme assignment: alternating deme 0/1 in taxon order A..F, resolved by taxon name -->
    <attributePatterns id="tipPatterns" attribute="state">
        <taxa idref="taxa"/>
        <generalDataType idref="mascot.dataType"/>
    </attributePatterns>

    <newick id="startingTree">
        (((A:1.0,B:1.0):1.0,(C:1.0,D:1.0):1.0):1.0,(E:2.0,F:2.0):1.0);
    </newick>

    <treeModel id="treeModel">
        <tree idref="startingTree"/>
        <rootHeight>
            <parameter id="treeModel.rootHeight"/>
        </rootHeight>
        <nodeHeights internalNodes="true">
            <parameter id="treeModel.internalNodeHeights"/>
        </nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true">
            <parameter id="treeModel.allInternalNodeHeights"/>
        </nodeHeights>
    </treeModel>

    <!-- flat log-migration-rate vector: [log m(0->1), log m(1->0)] -->
    <parameter id="theta" value="-1.6094379124341003 -1.2039728043259361"/>

    <!-- flat log-population-size vector: [log N0, log N1] -->
    <parameter id="popSizes" value="0.4054651081081644 0.5877866649021191"/>

    <mascotLikelihood id="mascotLikelihood" stateCount="2" maxStep="0.005" checkProbabilities="false">
        <treeModel idref="treeModel"/>
        <attributePatterns idref="tipPatterns"/>
        <theta>
            <parameter idref="theta"/>
        </theta>
        <popSizes>
            <parameter idref="popSizes"/>
        </popSizes>
    </mascotLikelihood>

    <mascotGradient id="likelihood.migration.grad" part="migration">
        <mascotLikelihood idref="mascotLikelihood"/>
    </mascotGradient>

    <mascotGradient id="likelihood.popSizes.grad" part="popSizes">
        <mascotLikelihood idref="mascotLikelihood"/>
    </mascotGradient>

    <normalPrior id="theta.prior" mean="0.0" stdev="1.0">
        <parameter idref="theta"/>
    </normalPrior>

    <gradient id="theta.prior.grad">
        <normalPrior idref="theta.prior"/>
        <parameter idref="theta"/>
    </gradient>

    <normalPrior id="popSizes.prior" mean="0.0" stdev="1.0">
        <parameter idref="popSizes"/>
    </normalPrior>

    <gradient id="popSizes.prior.grad">
        <normalPrior idref="popSizes.prior"/>
        <parameter idref="popSizes"/>
    </gradient>

    <jointGradient id="theta.posterior.grad">
        <mascotGradient idref="likelihood.migration.grad"/>
        <gradient idref="theta.prior.grad"/>
    </jointGradient>

    <jointGradient id="popSizes.posterior.grad">
        <mascotGradient idref="likelihood.popSizes.grad"/>
        <gradient idref="popSizes.prior.grad"/>
    </jointGradient>

    <compoundGradient id="posterior.grad">
        <jointGradient idref="theta.posterior.grad"/>
        <jointGradient idref="popSizes.posterior.grad"/>
    </compoundGradient>

    <report>
        <compoundGradient idref="posterior.grad"/>
    </report>

    <operators id="operators" optimizationSchedule="log">
        <hamiltonianMonteCarloOperator weight="1" nSteps="5" stepSize="0.005"
                                       gradientCheckCount="10" gradientCheckTolerance="1e-3">
            <compoundGradient idref="posterior.grad"/>
        </hamiltonianMonteCarloOperator>
    </operators>

    <mcmc id="mcmc" chainLength="2000" autoOptimize="true">
        <joint id="joint">
            <prior id="prior">
                <normalPrior idref="theta.prior"/>
                <normalPrior idref="popSizes.prior"/>
            </prior>
            <likelihood id="likelihood">
                <mascotLikelihood idref="mascotLikelihood"/>
            </likelihood>
        </joint>

        <operators idref="operators"/>

        <log id="screenLog" logEvery="100">
            <column label="Posterior" dp="4" width="12">
                <posterior idref="joint"/>
            </column>
            <column label="theta" dp="4" width="12">
                <parameter idref="theta"/>
            </column>
            <column label="popSizes" dp="4" width="12">
                <parameter idref="popSizes"/>
            </column>
        </log>

        <log id="fileLog" logEvery="10" fileName="testMascotHmcGradientCheck.log">
            <posterior idref="joint"/>
            <parameter idref="theta"/>
            <parameter idref="popSizes"/>
        </log>
    </mcmc>

    <traceAnalysis id="traceAnalysis" fileName="testMascotHmcGradientCheck.log" stdError="true"/>

</beast>
