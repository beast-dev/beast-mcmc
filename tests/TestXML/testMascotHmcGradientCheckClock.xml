<?xml version="1.0" standalone="yes"?>
<beast>

    <!--
        Clock-rate variant of testMascotHmcGradientCheck.xml: same fixed 6-tip,
        2-deme, single-epoch tree/theta/popSizes, plus a strictClockBranchRates
        wired into mascotLikelihood as an optional <branchRateModel> child.
        mascotGradient part="clockRate" exposes d(logLikelihood)/d(clockRate) as
        a third independently-addressable GradientWrtParameterProvider, combined
        with the migration/popSizes parts via the same jointGradient/
        compoundGradient pattern already used for those two. gradientCheckCount
        exercises BEAST's own built-in analytic-vs-finite-difference check
        against the full three-part combined gradient.
    -->

    <taxa id="taxa">
        <taxon id="A"><attr name="state">0</attr></taxon>
        <taxon id="B"><attr name="state">1</attr></taxon>
        <taxon id="C"><attr name="state">0</attr></taxon>
        <taxon id="D"><attr name="state">1</attr></taxon>
        <taxon id="E"><attr name="state">0</attr></taxon>
        <taxon id="F"><attr name="state">1</attr></taxon>
    </taxa>

    <generalDataType id="mascot.dataType">
        <state code="0"/>
        <state code="1"/>
    </generalDataType>

    <attributePatterns id="tipPatterns" attribute="state">
        <taxa idref="taxa"/>
        <generalDataType idref="mascot.dataType"/>
    </attributePatterns>

    <newick id="startingTree">
        (((A:1.0,B:1.0):1.0,(C:1.0,D:1.0):1.0):1.0,(E:2.0,F:2.0):1.0);
    </newick>

    <treeModel id="treeModel">
        <tree idref="startingTree"/>
        <rootHeight>
            <parameter id="treeModel.rootHeight"/>
        </rootHeight>
        <nodeHeights internalNodes="true">
            <parameter id="treeModel.internalNodeHeights"/>
        </nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true">
            <parameter id="treeModel.allInternalNodeHeights"/>
        </nodeHeights>
    </treeModel>

    <!-- flat positive migration-rate vector: [m(0->1), m(1->0)] -->
    <parameter id="theta" value="0.2 0.3" lower="0.0"/>

    <!-- flat natural-scale population-size vector: [N0, N1] -->
    <parameter id="popSizes" value="1.5 1.8"/>

    <!-- natural-scale clock rate in the model, with HMC moves made through a
         log transform below; started away from 1.0 so the gradient check
         exercises a genuinely nontrivial clock-scaling term. -->
    <parameter id="clockRate" value="1.2" lower="0.0"/>

    <strictClockBranchRates id="clockModel">
        <rate>
            <parameter idref="clockRate"/>
        </rate>
    </strictClockBranchRates>

    <structuredCoalescent type="MASCOT" id="mascotLikelihood" stateCount="2" maxStep="0.005" checkProbabilities="false">
        <treeModel idref="treeModel"/>
        <attributePatterns idref="tipPatterns"/>
        <migrationModel>
            <parameter idref="theta"/>
        </migrationModel>
        <popSizes>
            <parameter idref="popSizes"/>
        </popSizes>
        <strictClockBranchRates idref="clockModel"/>
    </structuredCoalescent>

    <structuredCoalescentLikelihoodGradient id="likelihood.migration.grad" wrtParameter="migrationRate">
        <structuredCoalescent idref="mascotLikelihood"/>
    </structuredCoalescentLikelihoodGradient>

    <structuredCoalescentLikelihoodGradient id="likelihood.popSizes.grad" wrtParameter="populationSize">
        <structuredCoalescent idref="mascotLikelihood"/>
    </structuredCoalescentLikelihoodGradient>

    <structuredCoalescentLikelihoodGradient id="likelihood.clockRate.grad" wrtParameter="clockRate">
        <structuredCoalescent idref="mascotLikelihood"/>
    </structuredCoalescentLikelihoodGradient>

    <exponentialPrior id="theta.prior" mean="0.25">
        <parameter idref="theta"/>
    </exponentialPrior>

    <gradient id="theta.prior.grad">
        <exponentialPrior idref="theta.prior"/>
        <parameter idref="theta"/>
    </gradient>

    <!-- log(popSizes) ~ Normal(0,1): same weakly informative prior as before,
         now expressed directly on the natural-scale parameter. -->
    <logNormalPrior id="popSizes.prior" meanInRealSpace="false" mean="0.0" stdev="1.0">
        <parameter idref="popSizes"/>
    </logNormalPrior>

    <gradient id="popSizes.prior.grad">
        <logNormalPrior idref="popSizes.prior"/>
        <parameter idref="popSizes"/>
    </gradient>

    <normalPrior id="clockRate.prior" mean="1.0" stdev="0.5">
        <parameter idref="clockRate"/>
    </normalPrior>

    <gradient id="clockRate.prior.grad">
        <normalPrior idref="clockRate.prior"/>
        <parameter idref="clockRate"/>
    </gradient>

    <jointGradient id="theta.posterior.grad">
        <structuredCoalescentLikelihoodGradient idref="likelihood.migration.grad"/>
        <gradient idref="theta.prior.grad"/>
    </jointGradient>

    <jointGradient id="popSizes.posterior.grad">
        <structuredCoalescentLikelihoodGradient idref="likelihood.popSizes.grad"/>
        <gradient idref="popSizes.prior.grad"/>
    </jointGradient>

    <jointGradient id="clockRate.posterior.grad">
        <structuredCoalescentLikelihoodGradient idref="likelihood.clockRate.grad"/>
        <gradient idref="clockRate.prior.grad"/>
    </jointGradient>

    <compoundGradient id="posterior.grad">
        <jointGradient idref="theta.posterior.grad"/>
        <jointGradient idref="popSizes.posterior.grad"/>
        <jointGradient idref="clockRate.posterior.grad"/>
    </compoundGradient>

    <report>
        <compoundGradient idref="posterior.grad"/>
    </report>

    <operators id="operators" optimizationSchedule="log">
        <hamiltonianMonteCarloOperator weight="1" nSteps="5" stepSize="0.005"
                                       gradientCheckCount="10" gradientCheckTolerance="1e-3">
            <compoundGradient idref="posterior.grad"/>
            <multivariateCompoundTransform>
                <transform type="log" dim="2"/>
                <transform type="log" dim="2"/>
                <transform type="log" dim="1"/>
            </multivariateCompoundTransform>
        </hamiltonianMonteCarloOperator>
    </operators>

    <mcmc id="mcmc" chainLength="20" autoOptimize="true">
        <joint id="joint">
            <prior id="prior">
                <exponentialPrior idref="theta.prior"/>
                <normalPrior idref="popSizes.prior"/>
                <normalPrior idref="clockRate.prior"/>
            </prior>
            <likelihood id="likelihood">
                <structuredCoalescent idref="mascotLikelihood"/>
            </likelihood>
        </joint>

        <operators idref="operators"/>

        <log id="screenLog" logEvery="10">
            <column label="Posterior" dp="4" width="12">
                <posterior idref="joint"/>
            </column>
            <column label="theta" dp="4" width="12">
                <parameter idref="theta"/>
            </column>
            <column label="popSizes" dp="4" width="12">
                <parameter idref="popSizes"/>
            </column>
            <column label="clockRate" dp="4" width="12">
                <parameter idref="clockRate"/>
            </column>
        </log>

        <log id="fileLog" logEvery="2" fileName="testMascotHmcGradientCheckClock.log">
            <posterior idref="joint"/>
            <parameter idref="theta"/>
            <parameter idref="popSizes"/>
            <parameter idref="clockRate"/>
        </log>
    </mcmc>

    <traceAnalysis id="traceAnalysis" fileName="testMascotHmcGradientCheckClock.log" stdError="true"/>

</beast>
