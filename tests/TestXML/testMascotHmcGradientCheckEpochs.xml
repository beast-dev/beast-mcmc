<?xml version="1.0" standalone="yes"?>
<beast>

    <!--
        Multi-epoch variant of testMascotHmcGradientCheck.xml: same fixed 6-tip,
        2-deme tree, but theta/popSizes now have TWO epochs (piecewise-constant
        migration rates/population sizes), wired via the optional gridPoints child
        of structuredCoalescent type="MASCOT" (BASTA's naming for the same
        strictly-increasing backward-time breakpoints concept). gridPoints has one
        boundary (dimension = epochCount-1), splitting the tree height (root at
        3.0) into a recent epoch [0,1.5) and an ancestral epoch [1.5,inf). theta
        and popSizes are each laid out epoch-major within themselves:
        theta    = [epoch0: m(0->1), m(1->0), epoch1: m(0->1), m(1->0)]
        popSizes = [epoch0: N0, N1,            epoch1: N0, N1] (natural-scale)
        MascotDynamics interleaves these into MascotCore's own epoch-major
        [migration, popSizes] layout on the way in, and de-interleaves MascotCore's
        combined gradient back into per-parameter slices on the way out (see
        structuredCoalescentLikelihoodGradient wrtParameter="migrationRate"/
        "populationSize" below); MascotCore's actual math never changes, only
        this wrapper-level bookkeeping.

        Because theta and popSizes stay as two independent, self-contained
        parameters (each just concatenated across epochs within itself, no
        cross-parameter interleaving visible at the XML level), combining their
        priors' gradients with the two structuredCoalescentLikelihoodGradient
        instances via jointGradient/compoundGradient works the same way
        regardless of epoch count, unlike an earlier version of this file (before
        the gradient exposed migration and popSizes as separate parts) where a
        single combined synthetic theta parameter's epoch-major-interleaved
        layout only happened to coincide with compoundGradient's plain
        concatenation at a single epoch.
    -->

    <taxa id="taxa">
        <taxon id="A"><attr name="state">0</attr></taxon>
        <taxon id="B"><attr name="state">1</attr></taxon>
        <taxon id="C"><attr name="state">0</attr></taxon>
        <taxon id="D"><attr name="state">1</attr></taxon>
        <taxon id="E"><attr name="state">0</attr></taxon>
        <taxon id="F"><attr name="state">1</attr></taxon>
    </taxa>

    <generalDataType id="mascot.dataType">
        <state code="0"/>
        <state code="1"/>
    </generalDataType>

    <attributePatterns id="tipPatterns" attribute="state">
        <taxa idref="taxa"/>
        <generalDataType idref="mascot.dataType"/>
    </attributePatterns>

    <newick id="startingTree">
        (((A:1.0,B:1.0):1.0,(C:1.0,D:1.0):1.0):1.0,(E:2.0,F:2.0):1.0);
    </newick>

    <treeModel id="treeModel">
        <tree idref="startingTree"/>
        <rootHeight>
            <parameter id="treeModel.rootHeight"/>
        </rootHeight>
        <nodeHeights internalNodes="true">
            <parameter id="treeModel.internalNodeHeights"/>
        </nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true">
            <parameter id="treeModel.allInternalNodeHeights"/>
        </nodeHeights>
    </treeModel>

    <!-- single epoch boundary at height 1.5 (root height is 3.0, so both epochs are exercised) -->
    <parameter id="epochTimes" value="1.5"/>

    <!-- epoch-major positive migration-rate vector: [e0: m(0->1), m(1->0), e1: m(0->1), m(1->0)] -->
    <parameter id="theta" value="0.36787944117144233 0.30119421191220214 0.6065306597126334 0.44932896411722156" lower="0.0"/>

    <!-- epoch-major natural-scale population-size vector: [e0: N0, N1, e1: N0, N1] -->
    <parameter id="popSizes" value="1.4918246976412703 1.8221188003905089 1.2214027581601699 1.3498588075760032"/>

    <structuredCoalescent type="MASCOT" id="mascotLikelihood" stateCount="2" maxStep="0.005" checkProbabilities="false">
        <treeModel idref="treeModel"/>
        <attributePatterns idref="tipPatterns"/>
        <migrationModel>
            <parameter idref="theta"/>
        </migrationModel>
        <popSizes>
            <parameter idref="popSizes"/>
        </popSizes>
        <gridPoints>
            <parameter idref="epochTimes"/>
        </gridPoints>
    </structuredCoalescent>

    <structuredCoalescentLikelihoodGradient id="likelihood.migration.grad" wrtParameter="migrationRate">
        <structuredCoalescent idref="mascotLikelihood"/>
    </structuredCoalescentLikelihoodGradient>

    <structuredCoalescentLikelihoodGradient id="likelihood.popSizes.grad" wrtParameter="populationSize">
        <structuredCoalescent idref="mascotLikelihood"/>
    </structuredCoalescentLikelihoodGradient>

    <exponentialPrior id="theta.prior" mean="0.25">
        <parameter idref="theta"/>
    </exponentialPrior>

    <gradient id="theta.prior.grad">
        <exponentialPrior idref="theta.prior"/>
        <parameter idref="theta"/>
    </gradient>

    <!-- log(popSizes) ~ Normal(0,1) per entry: same weakly informative prior as
         before, now expressed directly on the natural-scale parameter. -->
    <logNormalPrior id="popSizes.prior" meanInRealSpace="false" mean="0.0" stdev="1.0">
        <parameter idref="popSizes"/>
    </logNormalPrior>

    <gradient id="popSizes.prior.grad">
        <logNormalPrior idref="popSizes.prior"/>
        <parameter idref="popSizes"/>
    </gradient>

    <jointGradient id="theta.posterior.grad">
        <structuredCoalescentLikelihoodGradient idref="likelihood.migration.grad"/>
        <gradient idref="theta.prior.grad"/>
    </jointGradient>

    <jointGradient id="popSizes.posterior.grad">
        <structuredCoalescentLikelihoodGradient idref="likelihood.popSizes.grad"/>
        <gradient idref="popSizes.prior.grad"/>
    </jointGradient>

    <compoundGradient id="posterior.grad">
        <jointGradient idref="theta.posterior.grad"/>
        <jointGradient idref="popSizes.posterior.grad"/>
    </compoundGradient>

    <report>
        <compoundGradient idref="posterior.grad"/>
    </report>

    <operators id="operators" optimizationSchedule="log">
        <hamiltonianMonteCarloOperator weight="1" nSteps="5" stepSize="0.005"
                                       gradientCheckCount="10" gradientCheckTolerance="1e-3">
            <compoundGradient idref="posterior.grad"/>
            <multivariateCompoundTransform>
                <transform type="log" dim="4"/>
                <transform type="log" dim="4"/>
            </multivariateCompoundTransform>
        </hamiltonianMonteCarloOperator>
    </operators>

    <mcmc id="mcmc" chainLength="2000" autoOptimize="true">
        <joint id="joint">
            <prior id="prior">
                <exponentialPrior idref="theta.prior"/>
                <normalPrior idref="popSizes.prior"/>
            </prior>
            <likelihood id="likelihood">
                <structuredCoalescent idref="mascotLikelihood"/>
            </likelihood>
        </joint>

        <operators idref="operators"/>

        <log id="screenLog" logEvery="100">
            <column label="Posterior" dp="4" width="12">
                <posterior idref="joint"/>
            </column>
            <column label="theta" dp="4" width="12">
                <parameter idref="theta"/>
            </column>
            <column label="popSizes" dp="4" width="12">
                <parameter idref="popSizes"/>
            </column>
        </log>

        <log id="fileLog" logEvery="10" fileName="testMascotHmcGradientCheckEpochs.log">
            <posterior idref="joint"/>
            <parameter idref="theta"/>
            <parameter idref="popSizes"/>
        </log>
    </mcmc>

    <traceAnalysis id="traceAnalysis" fileName="testMascotHmcGradientCheckEpochs.log" stdError="true"/>

</beast>
