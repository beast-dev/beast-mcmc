<?xml version="1.0" standalone="yes"?>
<beast>

    <!--
        End-to-end test of MASCOT stochastic mapping. <stochasticMapping tag="location"> makes MascotLikelihood
        draw, at every log step, one joint sample of every node's location and every branch's complete
        location history from Pi_h (MASCOT's frozen-environment surrogate on its RK4 grid). The tree file
        then carries location (node states), location.history ({site, height, from, to} events with
        backward-time labels: from = descendant side), location.count and the register traits;
        markovJumpsLogger logs tree totals of location.count, location.fromZero and location.timeInZero;
        completeHistoryLogger logs every event. Same 6-tip, 3-deme model as
        testMascotAncestralStateLogging.xml.
    -->

    <taxa id="taxa">
        <taxon id="A"><attr name="state">0</attr></taxon>
        <taxon id="B"><attr name="state">1</attr></taxon>
        <taxon id="C"><attr name="state">2</attr></taxon>
        <taxon id="D"><attr name="state">0</attr></taxon>
        <taxon id="E"><attr name="state">1</attr></taxon>
        <taxon id="F"><attr name="state">2</attr></taxon>
    </taxa>

    <generalDataType id="mascot.dataType">
        <state code="0"/>
        <state code="1"/>
        <state code="2"/>
    </generalDataType>

    <attributePatterns id="tipPatterns" attribute="state">
        <taxa idref="taxa"/>
        <generalDataType idref="mascot.dataType"/>
    </attributePatterns>

    <newick id="startingTree">
        (((A:1.0,B:1.0):1.0,(C:1.0,D:1.0):1.0):1.0,(E:2.0,F:2.0):1.0);
    </newick>

    <treeModel id="treeModel">
        <tree idref="startingTree"/>
        <rootHeight>
            <parameter id="treeModel.rootHeight"/>
        </rootHeight>
        <nodeHeights internalNodes="true">
            <parameter id="treeModel.internalNodeHeights"/>
        </nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true">
            <parameter id="treeModel.allInternalNodeHeights"/>
        </nodeHeights>
    </treeModel>

    <complexSubstitutionModel id="location.model" randomizeIndicator="false"
                              normalized="false" scaleRatesByFrequencies="false"
                              checkConditioning="false">
        <generalDataType idref="mascot.dataType"/>
        <frequencies>
            <frequencyModel id="location.frequencyModel" normalize="true">
                <generalDataType idref="mascot.dataType"/>
                <frequencies>
                    <parameter id="location.frequencies" value="1.0 1.0 1.0" dimension="3"/>
                </frequencies>
            </frequencyModel>
        </frequencies>
        <rates>
            <parameter id="location.rates" value="0.11 0.23 0.17 0.31 0.29 0.37"
                       dimension="6" lower="0.0"/>
        </rates>
    </complexSubstitutionModel>

    <!-- natural-scale population sizes: [1.2, 1.6, 1.4] -->
    <parameter id="popSizes" value="1.2 1.6 1.4"/>

    <structuredCoalescent type="MASCOT" id="mascotLikelihood" stateCount="3" maxStep="0.005" checkProbabilities="false">
        <treeModel idref="treeModel"/>
        <attributePatterns idref="tipPatterns"/>
        <migrationModel>
            <complexSubstitutionModel idref="location.model"/>
        </migrationModel>
        <popSizes>
            <parameter idref="popSizes"/>
        </popSizes>
        <stochasticMapping tag="location">
            <counts>
                <!-- jumps away from deme 0 (backward time), i.e. forward-time migrations into deme 0 -->
                <parameter id="fromZero" value="0 1 1  0 0 0  0 0 0"/>
            </counts>
            <rewards>
                <parameter id="timeInZero" value="1 0 0"/>
            </rewards>
        </stochasticMapping>
    </structuredCoalescent>

    <operators id="operators" optimizationSchedule="log">
        <scaleOperator scaleFactor="0.9" weight="1">
            <parameter idref="location.rates"/>
        </scaleOperator>
    </operators>

    <mcmc id="mcmc" chainLength="10" autoOptimize="false">
        <posterior id="posterior">
            <likelihood id="likelihood">
                <structuredCoalescent idref="mascotLikelihood"/>
            </likelihood>
        </posterior>
        <operators idref="operators"/>
        <log id="screenLog" logEvery="1">
            <column label="posterior" dp="4" width="12">
                <posterior idref="posterior"/>
            </column>
        </log>
        <log id="jumpLog" logEvery="1" fileName="testMascotStochasticMapping.log">
            <markovJumpsLogger name="location.count">
                <structuredCoalescent idref="mascotLikelihood"/>
            </markovJumpsLogger>
            <markovJumpsLogger name="location.fromZero">
                <structuredCoalescent idref="mascotLikelihood"/>
            </markovJumpsLogger>
            <markovJumpsLogger name="location.timeInZero">
                <structuredCoalescent idref="mascotLikelihood"/>
            </markovJumpsLogger>
        </log>
        <log id="historyLog" logEvery="1" fileName="testMascotStochasticMapping.history.log">
            <completeHistoryLogger>
                <structuredCoalescent idref="mascotLikelihood"/>
            </completeHistoryLogger>
        </log>
        <logTree id="treeFileLog" logEvery="1" nexusFormat="true" fileName="testMascotStochasticMapping.trees">
            <structuredCoalescent idref="mascotLikelihood"/>
            <treeModel idref="treeModel"/>
        </logTree>
    </mcmc>

    <report>
        <property name="timer">
            <object idref="mcmc"/>
        </property>
    </report>

</beast>
