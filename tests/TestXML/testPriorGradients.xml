  <gammaPrior shape="2.5" scale="0.4" offset="2.0" id="prior.gammaOffset">
    <parameter idref="x.gammaOffset"/>
  </gammaPrior>
  <gradient id="gradient.gammaOffset">
    <gammaPrior idref="prior.gammaOffset"/>
