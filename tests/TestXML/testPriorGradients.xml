    <message>uniform prior gradient</message>
    <actual regex="analytic:(.*?)\n"><cachedReport idref="report.uniform"/></actual>
    <expected regex="numeric :(.*?)\n"><cachedReport idref="report.uniform"/></expected>
  </assertEqual>

</beast>
