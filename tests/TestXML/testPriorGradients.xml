<?xml version="1.0" standalone="yes"?>
<!-- Gradients of the univariate priors BEAUti writes, through <gradient>, against finite differences. The offset -->
<!-- priors check that the gradient is taken at x - offset; Laplace checks both sides of the mean.                -->
<beast>
  <parameter id="x.normal" value="-1.3 0.2 3.1"/>
  <normalPrior mean="0.5" stdev="2.0" id="prior.normal">
    <parameter idref="x.normal"/>
  </normalPrior>
  <gradient id="gradient.normal">
    <normalPrior idref="prior.normal"/>
    <parameter idref="x.normal"/>
  </gradient>
  <cachedReport id="report.normal">
    <report><gradient idref="gradient.normal"/></report>
  </cachedReport>
  <assertEqual tolerance="1E-6" verbose="true" charactersToStrip="\[\],">
    <message>normal prior gradient</message>
    <actual regex="analytic:(.*?)\n"><cachedReport idref="report.normal"/></actual>
    <expected regex="numeric :(.*?)\n"><cachedReport idref="report.normal"/></expected>
  </assertEqual>

  <parameter id="x.logNormal" value="0.3 1.7" lower="0.0"/>
  <logNormalPrior mu="-0.5" sigma="0.8" offset="0.0" id="prior.logNormal">
    <parameter idref="x.logNormal"/>
  </logNormalPrior>
  <gradient id="gradient.logNormal">
    <logNormalPrior idref="prior.logNormal"/>
    <parameter idref="x.logNormal"/>
  </gradient>
  <cachedReport id="report.logNormal">
    <report><gradient idref="gradient.logNormal"/></report>
  </cachedReport>
  <assertEqual tolerance="1E-6" verbose="true" charactersToStrip="\[\],">
    <message>logNormal prior gradient</message>
    <actual regex="analytic:(.*?)\n"><cachedReport idref="report.logNormal"/></actual>
    <expected regex="numeric :(.*?)\n"><cachedReport idref="report.logNormal"/></expected>
  </assertEqual>

  <parameter id="x.logNormalOffset" value="2.3 3.7" lower="2.0"/>
  <logNormalPrior mu="-0.5" sigma="0.8" offset="2.0" id="prior.logNormalOffset">
    <parameter idref="x.logNormalOffset"/>
  </logNormalPrior>
  <gradient id="gradient.logNormalOffset">
    <logNormalPrior idref="prior.logNormalOffset"/>
    <parameter idref="x.logNormalOffset"/>
