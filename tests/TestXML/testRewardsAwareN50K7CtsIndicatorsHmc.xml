            <parameter id="treeModel.internalNodeHeights"/>
        </nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true">
            <parameter id="treeModel.allInternalNodeHeights"/>
        </nodeHeights>
    </treeModel>

    <compoundParameter id="ind.rewardRates.values">
        <parameter id="ind.rewardRates.fixedValues" dimension="2" value="0 1" lower="0.0" upper="1.0"/>
        <parameter id="ind.rewardRates.varyingValues" dimension="5"
                   value="0.1666666667 0.3333333333 0.5 0.6666666667 0.8333333333"
                   lower="0.0" upper="1.0"/>
    </compoundParameter>
    <parameter id="ind.rewardRates.stateIndices" dimension="7" value="0 1 2 3 4 5 6" lower="0" upper="6"/>

    <arbitraryBranchRates id="ind.totalRewardsBranchRateModel" centerAtOne="false">
        <treeModel idref="treeModel"/>
        <rates>
            <parameter id="total.rewards.cts" dimension="98" value="0.45" lower="0.0" upper="1.0"/>
        </rates>
    </arbitraryBranchRates>

    <parameter id="bernoulliVar" dimension="98" value="0" lower="0" upper="1"/>
    <parameter id="atomIndex" dimension="98" value="2" lower="0" upper="6"/>

    <strictClockBranchRates id="ind.branchRates">
        <rate>
            <parameter id="ind.clock.rate" value="1.0" lower="0.0"/>
        </rate>
    </strictClockBranchRates>

    <rewardsAwareBranchModel id="ind.rewardModel">
        <arbitraryBranchRates idref="ind.totalRewardsBranchRateModel"/>
        <indicator>
            <parameter idref="bernoulliVar"/>
        </indicator>
        <atomIndices>
            <parameter idref="atomIndex"/>
        </atomIndices>
        <rewardRates id="ind.rewardRates">
            <fixedValues>
                <parameter idref="ind.rewardRates.fixedValues"/>
            </fixedValues>
            <varyingValues>
                <parameter idref="ind.rewardRates.varyingValues"/>
            </varyingValues>
            <stateIndices>
                <parameter idref="ind.rewardRates.stateIndices"/>
            </stateIndices>
        </rewardRates>
        <logRateSubstitutionModel id="ind.submodel" normalize="true" scaleRatesByFrequencies="false">
            <generalDataType idref="ind.dataType"/>
            <rootFrequencies>
                <frequencyModel id="ind.frequencyModel" normalize="true">
                    <generalDataType idref="ind.dataType"/>
                    <frequencies>
                        <parameter id="ind.frequencies" dimension="7"
                                   value="0.1428571429 0.1428571429 0.1428571429 0.1428571429 0.1428571429 0.1428571429 0.1428571426"/>
                    </frequencies>
                </frequencyModel>
            </rootFrequencies>
            <logRates>
                <parameter id="ind.logRates" dimension="42" value="-2.0"/>
            </logRates>
        </logRateSubstitutionModel>
    </rewardsAwareBranchModel>

    <indexedParameter id="total.reward.pointMasses">
        <values>
            <parameter idref="ind.rewardRates.values"/>
        </values>
        <indices>
            <parameter idref="atomIndex"/>
        </indices>
    </indexedParameter>

    <sumParameter id="total.rewards">
        <productParameter>
            <parameter idref="bernoulliVar"/>
            <indexedParameter idref="total.reward.pointMasses"/>
        </productParameter>
        <productParameter>
            <differenceParameter>
                <parameter dimension="98" value="1"/>
                <parameter idref="bernoulliVar"/>
            </differenceParameter>
            <parameter idref="total.rewards.cts"/>
        </productParameter>
    </sumParameter>

    <siteModel id="ind.siteModel">
        <substitutionModel>
            <logRateSubstitutionModel idref="ind.submodel"/>
        </substitutionModel>
    </siteModel>

    <treeDataLikelihood id="ind.treeLikelihood" useAmbiguities="false"
                        usePreOrder="true" branchRateDerivative="true"
                        scalingScheme="always" delayScaling="false">
        <patterns idref="ind.pattern"/>
        <siteModel idref="ind.siteModel"/>
        <treeModel idref="treeModel"/>
        <rewardsAwareBranchModel idref="ind.rewardModel"/>
        <strictClockBranchRates idref="ind.branchRates"/>
    </treeDataLikelihood>

    <rewardAwareBranchModelGradient id="rewardGrad" traitName="rewardGrad" isIndicatorBaseOne="true">
        <treeDataLikelihood idref="ind.treeLikelihood"/>
        <rewardsAwareBranchModel idref="ind.rewardModel"/>
        <arbitraryBranchRates idref="ind.totalRewardsBranchRateModel"/>
        <indicator>
            <parameter idref="bernoulliVar"/>
        </indicator>
    </rewardAwareBranchModelGradient>

    <jointGradient id="jointGradient">
        <rewardAwareBranchModelGradient idref="rewardGrad"/>
    </jointGradient>

    <operators id="operators" optimizationSchedule="default">
        <hamiltonianMonteCarloOperator id="totalRewardsCtsHMC" weight="10.0"
                                       nSteps="20" stepSize="1E-2"
                                       mode="vanilla" autoOptimize="true">
            <jointGradient idref="jointGradient"/>
            <parameter idref="total.rewards.cts"/>
            <transform type="logit" dim="98"/>
        </hamiltonianMonteCarloOperator>

        <rewardsMixtureIndicatorAndAtomIndicesOperator id="indicatorAtomGibbs" weight="30.0"
                                                       updateProportion="0.1"
                                                       autoOptimize="true"
                                                       useClusterMoves="true"
                                                       clusterSize="4"
                                                       clusterBorderBias="0.8">
            <treeDataLikelihood idref="ind.treeLikelihood"/>
            <rewardsAwareBranchModel idref="ind.rewardModel"/>
            <indicatorZ>
                <parameter idref="bernoulliVar"/>
            </indicatorZ>
            <atomIndex>
                <parameter idref="atomIndex"/>
            </atomIndex>
        </rewardsMixtureIndicatorAndAtomIndicesOperator>
    </operators>

    <sumStatistic id="sumIndicators">
        <parameter idref="bernoulliVar"/>
    </sumStatistic>

    <mcmc id="mcmc" chainLength="100000" autoOptimize="true"
          operatorAnalysis="testRewardsAwareN50K7CtsIndicatorsHmc.ops"
          smoothAcceptanceRatio="true" fullEvaluation="0">
        <joint id="joint">
            <prior id="prior">
                <uniformPrior lower="0.0" upper="1.0">
                    <parameter idref="total.rewards.cts"/>
                </uniformPrior>
            </prior>
            <likelihood id="likelihood">
                <treeDataLikelihood idref="ind.treeLikelihood"/>
            </likelihood>
        </joint>
        <operators idref="operators"/>

        <log id="screenLog" logEvery="1000">
            <column label="Joint" dp="4" width="12">
                <joint idref="joint"/>
            </column>
            <column label="ind.sum" dp="0" width="8">
                <sumStatistic idref="sumIndicators"/>
            </column>
        </log>

        <log id="fileLog" logEvery="1000" fileName="testRewardsAwareN50K7CtsIndicatorsHmc.log">
            <joint idref="joint"/>
            <treeDataLikelihood idref="ind.treeLikelihood"/>
            <parameter idref="total.rewards.cts"/>
            <parameter idref="bernoulliVar"/>
            <parameter idref="atomIndex"/>
            <sumParameter idref="total.rewards"/>
            <sumStatistic idref="sumIndicators"/>
        </log>
    </mcmc>

</beast>
