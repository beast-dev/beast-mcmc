<?xml version="1.0" encoding="utf-8"?>
<beast version="10.5.0-beta4">

    <!-- Derived from np-ctmcs/public-code/code/xml/rabies/rabies_LL.xml:                -->
    <!-- 5 real taxa, real "host" discrete-trait values, and the first 60 real DNA        -->
    <!-- sites for those taxa. Host is the primary reward-aware CTMC; the DNA alignment   -->
    <!-- is one dependent CTMC likelihood (pattern-compressed, not one likelihood per     -->
    <!-- site) attached through rewardMixtureCategoricalDiscontinuousPotential.           -->

    <taxa id="taxa">
        <taxon id="AZ4030_2005.5">
            <attr name="host">Ap</attr>
        </taxon>
        <taxon id="AZ1968_2004.5">
            <attr name="host">Ef</attr>
        </taxon>
        <taxon id="AZ7590_2005.5">
            <attr name="host">Ef</attr>
        </taxon>
        <taxon id="FL701_2003.5">
            <attr name="host">Lb</attr>
        </taxon>
        <taxon id="AZ2405_2005.5">
            <attr name="host">Tb</attr>
        </taxon>
    </taxa>

    <!-- host trait, taken verbatim from rabies_LL.xml <attr name="host"> values -->
    <generalDataType id="host.dataType">
        <state code="Ap"/>
        <state code="Ef"/>
        <state code="Lb"/>
        <state code="Tb"/>
    </generalDataType>

    <attributePatterns id="host.pattern" attribute="host">
        <taxa idref="taxa"/>
        <generalDataType idref="host.dataType"/>
    </attributePatterns>

    <!-- first 60 real nucleotide sites for the same 5 taxa, from rabies_LL.xml <alignment id="alignment"> -->
    <alignment id="dep.alignment" dataType="nucleotide">
        <sequence>
            <taxon idref="AZ4030_2005.5"/>
            ATGGATGCCGACAAGATTGTATTTAAAGTCAATAATCAGGTGGTTTCTCTGAAGCCTGAG
        </sequence>
        <sequence>
            <taxon idref="AZ1968_2004.5"/>
            ATGGATGCCGACAAGATTGTATTCAAAGTCAATAATAAGGTGGTCTCTCTGAAGCCTGAA
        </sequence>
        <sequence>
            <taxon idref="AZ7590_2005.5"/>
            ATGGATGCCGACAAGATTGTATTTAAAGTCAAGAATCAGGTGGTCTCCTTGAAGCCTGAG
        </sequence>
        <sequence>
            <taxon idref="FL701_2003.5"/>
            ATGGATGCTGACAAGATTGTATTTAAAGTCAAGAATCAGGTGGTCTCCTTGAAGCCTGAG
        </sequence>
        <sequence>
            <taxon idref="AZ2405_2005.5"/>
            ATGGATGCCGACAAGATTGTATTCAAGGTCAATAATCAGGTGGTCTCTCTGAAGCCTGAA
        </sequence>
    </alignment>

    <patterns id="dep.patterns" from="1">
        <alignment idref="dep.alignment"/>
    </patterns>

    <newick id="startingTree">
        (((AZ4030_2005.5:0.3,AZ1968_2004.5:0.3):0.2,AZ7590_2005.5:0.5):0.2,(FL701_2003.5:0.4,AZ2405_2005.5:0.4):0.3);
    </newick>

    <treeModel id="treeModel" fixHeights="true">
        <tree idref="startingTree"/>
        <rootHeight>
            <parameter id="treeModel.rootHeight"/>
        </rootHeight>
        <nodeHeights internalNodes="true">
            <parameter id="treeModel.internalNodeHeights"/>
        </nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true">
            <parameter id="treeModel.allInternalNodeHeights"/>
        </nodeHeights>
    </treeModel>

    <!-- reward rates over the 4 host states: Ap=0 (fixed 0.0), Ef=1 (fixed 1.0), -->
    <!-- Lb=2 (varying, init 0.25), Tb=3 (varying, init 0.75) -->
    <compoundParameter id="host.rewardRates.values">
        <parameter id="host.rewardRates.fixedValues" dimension="2" value="0.0 1.0" lower="0.0" upper="1.0"/>
        <parameter id="host.rewardRates.varyingValues" dimension="2" value="0.25 0.75" lower="0.0" upper="1.0"/>
    </compoundParameter>
    <parameter id="host.rewardRates.stateIndices" dimension="4" value="0 1 2 3" lower="0" upper="3"/>

    <rewardRates id="host.rewardRates">
        <fixedValues>
            <parameter idref="host.rewardRates.fixedValues"/>
        </fixedValues>
        <varyingValues>
            <parameter idref="host.rewardRates.varyingValues"/>
        </varyingValues>
        <stateIndices>
            <parameter idref="host.rewardRates.stateIndices"/>
        </stateIndices>
    </rewardRates>

    <!-- 5 tips -> 8 branches -->
    <parameter id="total.rewards.cts" dimension="8" value="0.50 0.50 0.50 0.50 0.50 0.50 0.50 0.50" lower="0.0" upper="1.0"/>
    <parameter id="reward.category" dimension="8" value="0.50 0.50 0.50 0.50 0.50 0.50 0.50 0.50" lower="0.0" upper="5.0"/>
    <parameter id="reward.category.cuts" dimension="6" value="0 1 2 3 4 5"/>

    <rewardsAwareCategoricalMixtureBranchRates id="host.totalRewardsBranchRateModel">
        <treeModel idref="treeModel"/>
        <ctsParameter>
            <parameter idref="total.rewards.cts"/>
        </ctsParameter>
        <categoryState>
            <parameter idref="reward.category"/>
        </categoryState>
        <categoryCuts>
            <parameter idref="reward.category.cuts"/>
        </categoryCuts>
        <rewardRates idref="host.rewardRates"/>
    </rewardsAwareCategoricalMixtureBranchRates>

    <strictClockBranchRates id="host.branchRates">
        <rate>
            <parameter id="host.clock.rate" value="1.0" lower="0.0"/>
        </rate>
    </strictClockBranchRates>

    <!-- symmetric CTMC over the 4 host states, same shape as rabies_LL.xml's "state.model" -->
    <generalSubstitutionModel id="host.model">
        <generalDataType idref="host.dataType"/>
        <frequencies>
            <frequencyModel id="host.frequencyModel" normalize="true">
                <generalDataType idref="host.dataType"/>
                <frequencies>
                    <parameter id="host.frequencies" dimension="4" value="0.25 0.25 0.25 0.25"/>
                </frequencies>
            </frequencyModel>
        </frequencies>
        <rates>
            <parameter id="host.rates" dimension="6" value="1.0" lower="0.0"/>
        </rates>
    </generalSubstitutionModel>

    <rewardsAwareBranchModel id="host.rewardModel">
        <rewardsAwareCategoricalMixtureBranchRates idref="host.totalRewardsBranchRateModel"/>
        <categoryState>
            <parameter idref="reward.category"/>
        </categoryState>
        <categoryCuts>
            <parameter idref="reward.category.cuts"/>
        </categoryCuts>
        <rewardRates idref="host.rewardRates"/>
        <generalSubstitutionModel idref="host.model"/>
    </rewardsAwareBranchModel>

    <siteModel id="host.siteModel">
        <substitutionModel>
            <generalSubstitutionModel idref="host.model"/>
        </substitutionModel>
    </siteModel>

    <treeDataLikelihood id="host.treeLikelihood" useAmbiguities="false"
                        usePreOrder="true" branchRateDerivative="true"
                        useRewardAwareBranchModelDelegate="true"
                        scalingScheme="never" delayScaling="false">
        <patterns idref="host.pattern"/>
        <siteModel idref="host.siteModel"/>
        <treeModel idref="treeModel"/>
        <rewardsAwareBranchModel idref="host.rewardModel"/>
        <strictClockBranchRates idref="host.branchRates"/>
    </treeDataLikelihood>

    <!-- dependent DNA CTMC: HKY + 4-category gamma, matching rabies_LL.xml's real DNA site model -->
    <hkyModel id="dna.submodel">
        <frequencies>
            <frequencyModel id="dna.frequencyModel" dataType="nucleotide">
                <frequencies>
                    <parameter id="dna.frequencies" value="0.25 0.25 0.25 0.25"/>
                </frequencies>
            </frequencyModel>
        </frequencies>
        <kappa>
            <parameter id="dna.kappa" value="2.0" lower="0.0"/>
        </kappa>
    </hkyModel>

    <siteModel id="dna.siteModel">
        <substitutionModel>
            <hkyModel idref="dna.submodel"/>
        </substitutionModel>
        <gammaShape gammaCategories="4">
            <parameter id="dna.alpha" value="0.5" lower="0.0"/>
        </gammaShape>
    </siteModel>

    <!-- single dependent treeDataLikelihood over the whole (pattern-compressed) DNA alignment; -->
    <!-- this is the piece that replaces "one dependent CTMC per site" -->
    <treeDataLikelihood id="dna.rewardTreeLikelihood" useAmbiguities="false"
                        usePreOrder="true" branchRateDerivative="true"
                        useSpectralRepresentation="false"
                        scalingScheme="never" delayScaling="false">
        <patterns idref="dep.patterns"/>
        <siteModel idref="dna.siteModel"/>
        <treeModel idref="treeModel"/>
        <rewardsAwareCategoricalMixtureBranchRates idref="host.totalRewardsBranchRateModel"/>
    </treeDataLikelihood>

    <rewardMixtureCategoricalDiscontinuousPotential id="rewardCategoryPotential">
        <categoryState>
            <parameter idref="reward.category"/>
        </categoryState>
        <categoryCuts>
            <parameter idref="reward.category.cuts"/>
        </categoryCuts>
        <rewardsAwareBranchModel idref="host.rewardModel"/>
        <treeDataLikelihood idref="host.treeLikelihood"/>
        <dependentCtmcLikelihoods>
            <treeDataLikelihood idref="dna.rewardTreeLikelihood"/>
        </dependentCtmcLikelihoods>
    </rewardMixtureCategoricalDiscontinuousPotential>

    <operators id="operators">
        <discontinuousHamiltonianMonteCarloOperator id="rewardCategoryDHMC"
                                                   weight="1.0"
                                                   stepSize="0.25"
                                                   nSteps="2"
                                                   gradientCheckCount="10"
                                                   gradientCheckTolerance="1E-3">
            <parameter idref="reward.category"/>
            <rewardMixtureCategoricalDiscontinuousPotential idref="rewardCategoryPotential"/>
        </discontinuousHamiltonianMonteCarloOperator>
    </operators>

    <mcmc id="mcmc" chainLength="4" autoOptimize="false"
          operatorAnalysis="testRewardsAwareRabiesHostDnaSmoke.ops">
        <joint id="joint">
            <prior id="prior"/>
            <likelihood id="likelihood">
                <treeDataLikelihood idref="host.treeLikelihood"/>
                <treeDataLikelihood idref="dna.rewardTreeLikelihood"/>
            </likelihood>
        </joint>
        <operators idref="operators"/>
        <log id="screenLog" logEvery="1">
            <joint idref="joint"/>
            <treeDataLikelihood idref="host.treeLikelihood"/>
            <treeDataLikelihood idref="dna.rewardTreeLikelihood"/>
            <parameter idref="total.rewards.cts"/>
            <parameter idref="reward.category"/>
        </log>
    </mcmc>

</beast>
