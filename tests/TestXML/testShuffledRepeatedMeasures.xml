<?xml version="1.0" standalone="yes"?>
<beast>

	<!-- Repeated measures given as per-taxon <shuffle> blocks inside <data> must be re-ordered to match leafTraits -->

	<taxa id="taxa">
		<taxon id="A">
			<attr name="X">1.0 2.0</attr>
		</taxon>
		<taxon id="B">
			<attr name="X">-1.0 0.5</attr>
		</taxon>
		<taxon id="C">
			<attr name="X">3.0 -2.0</attr>
		</taxon>
	</taxa>

	<newick id="tree">
		((C:1,A:1):1,B:2);
	</newick>

	<treeModel id="treeModel">
		<newick idref="tree"/>
		<rootHeight>
			<parameter id="treeModel.rootHeight"/>
		</rootHeight>
		<nodeHeights internalNodes="true">
			<parameter id="treeModel.internalNodeHeights"/>
		</nodeHeights>
		<nodeHeights internalNodes="true" rootNode="true">
			<parameter id="treeModel.allInternalNodeHeights"/>
		</nodeHeights>
		<nodeTraits name="X" rootNode="false" internalNodes="false" leafNodes="true" traitDimension="2"
					asMatrix="true">
			<parameter id="leafTraits"/>
		</nodeTraits>
	</treeModel>

	<continuousTraitDataModel id="traits" traitName="X" numTraits="1">
		<treeModel idref="treeModel"/>
		<traitParameter>
			<parameter idref="leafTraits"/>
		</traitParameter>
	</continuousTraitDataModel>

	<!-- Banded precision couples neighbouring taxa, so mis-aligned repetition labels change the density -->
	<matrixParameter id="sampling.precision">
		<parameter value="2.0 0.4 0.0 0.0 0.0 0.0"/>
		<parameter value="0.4 1.5 0.4 0.0 0.0 0.0"/>
		<parameter value="0.0 0.4 3.0 0.4 0.0 0.0"/>
		<parameter value="0.0 0.0 0.4 2.5 0.4 0.0"/>
		<parameter value="0.0 0.0 0.0 0.4 1.0 0.4"/>
		<parameter value="0.0 0.0 0.0 0.0 0.4 2.0"/>
	</matrixParameter>

	<!-- Taxon blocks and repetition labels deliberately out of leafTraits order -->
	<multivariateDistributionLikelihood id="shuffled.density">
		<distribution>
			<multivariateNormalDistributionModel>
				<meanParameter>
					<parameter idref="leafTraits"/>
				</meanParameter>
				<precisionParameter>
					<matrixParameter idref="sampling.precision"/>
				</precisionParameter>
			</multivariateNormalDistributionModel>
		</distribution>
		<data>
			<shuffle taxon="B">
				<repetition label="1">-0.9 0.4</repetition>
				<repetition label="2">-1.3 0.7</repetition>
				<repetition label="3">-1.0 0.2</repetition>
			</shuffle>
			<shuffle taxon="C">
				<repetition label="3">3.4 -2.1</repetition>
				<repetition label="1">2.7 -2.2</repetition>
				<repetition label="2">3.1 -1.6</repetition>
			</shuffle>
			<shuffle taxon="A">
				<repetition label="2">0.8 1.9</repetition>
				<repetition label="3">1.2 2.1</repetition>
				<repetition label="1">1.1 2.3</repetition>
			</shuffle>
		</data>
	</multivariateDistributionLikelihood>

	<!-- The same data written by hand in leafTraits order (C, A, B for this tree) -->
	<multivariateDistributionLikelihood id="ordered.density">
		<distribution>
			<multivariateNormalDistributionModel>
				<meanParameter>
					<parameter idref="leafTraits"/>
				</meanParameter>
				<precisionParameter>
					<matrixParameter idref="sampling.precision"/>
				</precisionParameter>
			</multivariateNormalDistributionModel>
		</distribution>
		<data>
			<parameter id="repetition.1" value="2.7 -2.2  1.1 2.3  -0.9 0.4"/>
			<parameter id="repetition.2" value="3.1 -1.6  0.8 1.9  -1.3 0.7"/>
			<parameter id="repetition.3" value="3.4 -2.1  1.2 2.1  -1.0 0.2"/>
		</data>
	</multivariateDistributionLikelihood>

	<!-- Shows the leafTraits order (C, A, B) that the hand-ordered density assumes -->
	<report>
		<parameter idref="leafTraits"/>
	</report>

	<assertEqual tolerance="1e-10" toleranceType="absolute" verbose="true">
		<message>
			Check log density of shuffled repeated measures
		</message>
		<actual regex="likelihood:\s+(.*)\n">
			<likelihood>
				<multivariateDistributionLikelihood idref="shuffled.density"/>
			</likelihood>
		</actual>
		<expected>
			-12.1199300614984
		</expected>
	</assertEqual>

	<assertEqual tolerance="1e-10" toleranceType="absolute" verbose="true">
		<message>
			Check log density of hand-ordered repeated measures
		</message>
		<actual regex="likelihood:\s+(.*)\n">
			<likelihood>
				<multivariateDistributionLikelihood idref="ordered.density"/>
			</likelihood>
		</actual>
		<expected>
			-12.1199300614984
		</expected>
	</assertEqual>

</beast>
