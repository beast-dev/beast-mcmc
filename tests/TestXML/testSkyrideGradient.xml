<?xml version="1.0" standalone="yes"?>
<!-- GMRF Skyride gradients wrt the log population sizes, the precision and the node heights, against finite      -->
<!-- differences: BEAUti's default (time-aware smoothing rescaled by the root height), time-aware without         -->
<!-- rescaling, uniform smoothing, lambda < 1, and a tree with tips sampled at different times.                   -->
<beast>
  <taxa id="taxa">
    <taxon id="A"/><taxon id="B"/><taxon id="C"/><taxon id="D"/><taxon id="E"/>
  </taxa>
  <newick id="tree.start" usingDates="false">((A:0.12,B:0.12):0.31,(C:0.25,(D:0.07,E:0.07):0.18):0.18);</newick>
  <treeModel id="tree">
    <tree idref="tree.start"/>
    <rootHeight><parameter id="tree.rootHeight"/></rootHeight>
    <nodeHeights internalNodes="true"><parameter id="tree.internalNodeHeights"/></nodeHeights>
    <nodeHeights internalNodes="true" rootNode="true"><parameter id="tree.allInternalNodeHeights"/></nodeHeights>
  </treeModel>
  <newick id="datedTree.start" usingDates="false">((A:0.12,B:0.32):0.31,(C:0.25,(D:0.07,E:0.17):0.18):0.18);</newick>
  <treeModel id="datedTree">
    <tree idref="datedTree.start"/>
    <rootHeight><parameter id="datedTree.rootHeight"/></rootHeight>
    <nodeHeights internalNodes="true"><parameter id="datedTree.internalNodeHeights"/></nodeHeights>
    <nodeHeights internalNodes="true" rootNode="true"><parameter id="datedTree.allInternalNodeHeights"/></nodeHeights>
  </treeModel>

  <gmrfSkyrideLikelihood id="skyride" timeAwareSmoothing="true" randomizeTree="false">
    <populationSizes><parameter id="skyride.logPopSize" value="0.3 -0.2 0.5 0.1"/></populationSizes>
    <groupSizes><parameter id="skyride.groupSize" dimension="4"/></groupSizes>
    <precisionParameter><parameter id="skyride.precision" value="2.5" lower="0.0"/></precisionParameter>
    <populationTree><treeModel idref="tree"/></populationTree>
  </gmrfSkyrideLikelihood>
  <gmrfSkyrideGradient id="gradient.skyride.logPopulationSizes" wrtParameter="logPopulationSizes">
    <gmrfSkyrideLikelihood idref="skyride"/>
  </gmrfSkyrideGradient>
  <cachedReport id="report.gradient.skyride.logPopulationSizes"><report><gmrfSkyrideGradient idref="gradient.skyride.logPopulationSizes"/></report></cachedReport>
  <assertEqual tolerance="1E-5" verbose="true" charactersToStrip="\[\],">
    <message>skyride gradient wrt logPopulationSizes, analytic against numeric</message>
    <actual regex="analytic:(.*?)\n"><cachedReport idref="report.gradient.skyride.logPopulationSizes"/></actual>
    <expected regex="numeric :(.*?)\n"><cachedReport idref="report.gradient.skyride.logPopulationSizes"/></expected>
  </assertEqual>
  <gmrfSkyrideGradient id="gradient.skyride.precision" wrtParameter="precision">
    <gmrfSkyrideLikelihood idref="skyride"/>
  </gmrfSkyrideGradient>
  <cachedReport id="report.gradient.skyride.precision"><report><gmrfSkyrideGradient idref="gradient.skyride.precision"/></report></cachedReport>
  <assertEqual tolerance="1E-5" verbose="true" charactersToStrip="\[\],">
    <message>skyride gradient wrt precision, analytic against numeric</message>
    <actual regex="analytic:(.*?)\n"><cachedReport idref="report.gradient.skyride.precision"/></actual>
    <expected regex="numeric :(.*?)\n"><cachedReport idref="report.gradient.skyride.precision"/></expected>
  </assertEqual>
