  <gmrfSkyrideLikelihood id="noRescale" timeAwareSmoothing="true" rescaleByRootHeight="false" randomizeTree="false">
    <populationSizes><parameter id="noRescale.logPopSize" value="0.3 -0.2 0.5 0.1"/></populationSizes>
    <groupSizes><parameter id="noRescale.groupSize" dimension="4"/></groupSizes>
    <precisionParameter><parameter id="noRescale.precision" value="2.5" lower="0.0"/></precisionParameter>
