  </gmrfSkyrideGradient>
  <cachedReport id="report.gradient.skyride.nodeHeight"><report><gmrfSkyrideGradient idref="gradient.skyride.nodeHeight"/></report></cachedReport>
  <assertEqual tolerance="1E-5" verbose="true" charactersToStrip="\[\],">
    <message>skyride gradient wrt nodeHeight, analytic against numeric</message>
    <actual regex="analytic:(.*?)\n"><cachedReport idref="report.gradient.skyride.nodeHeight"/></actual>
    <expected regex="numeric :(.*?)\n"><cachedReport idref="report.gradient.skyride.nodeHeight"/></expected>
