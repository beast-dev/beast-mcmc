<?xml version="1.0" encoding="utf-8"?>
<beast>

    <taxa id="taxa">
        <taxon id="taxon_1">
            <attr name="loc">A</attr>
        </taxon>
        <taxon id="taxon_2">
            <attr name="loc">A</attr>
        </taxon>
        <taxon id="taxon_3">
            <attr name="loc">B</attr>
        </taxon>
        <taxon id="taxon_4">
            <attr name="loc">B</attr>
        </taxon>
        <taxon id="taxon_5">
            <attr name="loc">A</attr>
        </taxon>
    </taxa>

    <generalDataType id="loc.dataType">
        <state code="A"/>
        <state code="B"/>
        <state code="C"/>
    </generalDataType>

    <attributePatterns id="loc.pattern" attribute="loc">
        <taxa idref="taxa"/>
        <generalDataType idref="loc.dataType"/>
    </attributePatterns>

    <newick id="startingTree" usingHeights="true" usingDates="false">
        ((taxon_1:1.0,taxon_2:1.5):2.0,(taxon_3:0.8,(taxon_4:1.2,taxon_5:1.2):0.6):1.5);
    </newick>

    <treeModel id="treeModel" fixHeights="true">
        <tree idref="startingTree"/>
        <rootHeight>
            <parameter id="treeModel.rootHeight"/>
        </rootHeight>
        <nodeHeights internalNodes="true">
            <parameter id="treeModel.internalNodeHeights"/>
        </nodeHeights>
        <nodeHeights internalNodes="true" rootNode="true">
            <parameter id="treeModel.allInternalNodeHeights"/>
        </nodeHeights>
    </treeModel>

    <strictClockBranchRates id="loc.branchRates">
        <rate>
            <parameter id="loc.clock.rate" value="1.0" lower="0.0"/>
        </rate>
    </strictClockBranchRates>

    <logRateSubstitutionModel id="loc.model" normalize="true" scaleRatesByFrequencies="false">
        <generalDataType idref="loc.dataType"/>
        <rootFrequencies>
            <frequencyModel id="loc.frequencyModel" normalize="true">
                <generalDataType idref="loc.dataType"/>
                <frequencies>
                    <parameter id="loc.frequencies" dimension="3" value="0.333 0.333 0.334"/>
                </frequencies>
            </frequencyModel>
        </rootFrequencies>
        <logRates>
            <parameter id="loc.logRates" dimension="6" value="0.5 -0.3 0.1 -0.5 0.2 -0.1"/>
        </logRates>
    </logRateSubstitutionModel>

    <siteModel id="loc.siteModel">
        <substitutionModel>
            <logRateSubstitutionModel idref="loc.model"/>
        </substitutionModel>
    </siteModel>

    <treeDataLikelihood id="treeLikelihood" useAmbiguities="true"
                        usePreOrder="true"
                        useSpectralRepresentation="true"
                        scalingScheme="none" delayScaling="false">
        <patterns idref="loc.pattern"/>
        <treeModel idref="treeModel"/>
        <siteModel idref="loc.siteModel"/>
        <strictClockBranchRates idref="loc.branchRates"/>
    </treeDataLikelihood>

    <approximateLogCtmcRateGradient id="spectralBeagleGradient" traitName="loc" mode="exact">
        <treeDataLikelihood idref="treeLikelihood"/>
        <logRateSubstitutionModel idref="loc.model"/>
    </approximateLogCtmcRateGradient>

    <report>
        <approximateLogCtmcRateGradient idref="spectralBeagleGradient"/>
    </report>

    <!-- Static gradient check: analytic matches numeric -->
    <assertEqual tolerance="1e-4" verbose="true" charactersToStrip="\[\],">
        <message>
            Check SpectralBeagleCrossProductDelegate: analytic gradient matches numeric gradient
        </message>
        <actual regex="analytic: (.*?)\n">
            <approximateLogCtmcRateGradient idref="spectralBeagleGradient"/>
        </actual>
        <expected regex="numeric : (.*?)\n">
            <approximateLogCtmcRateGradient idref="spectralBeagleGradient"/>
        </expected>
    </assertEqual>

    <!--
        HMC operator on loc.logRates using SpectralBeagleCrossProductDelegate.
        gradientCheckCount="100" forces numeric gradient checks through the short chain.
    -->
    <operators id="operators">
        <hamiltonianMonteCarloOperator weight="1.0" nSteps="3" stepSize="0.01"
                                       drawVariance="1.0" autoOptimize="false"
                                       gradientCheckCount="100" gradientCheckTolerance="1e-4">
            <approximateLogCtmcRateGradient idref="spectralBeagleGradient"/>
            <parameter idref="loc.logRates"/>
        </hamiltonianMonteCarloOperator>
    </operators>

    <mcmc id="mcmc" chainLength="15" autoOptimize="false">
        <posterior id="posterior">
            <prior id="prior">
                <!-- No prior on log rates: posterior = likelihood only -->
            </prior>
            <likelihood id="likelihood">
                <treeDataLikelihood idref="treeLikelihood"/>
            </likelihood>
        </posterior>
        <operators idref="operators"/>
        <log id="screenLog" logEvery="5">
            <column label="Posterior" dp="4" width="12">
                <posterior idref="posterior"/>
            </column>
            <column label="Likelihood" dp="4" width="12">
                <likelihood idref="likelihood"/>
            </column>
            <column label="loc.logRates" sf="4" width="14">
                <parameter idref="loc.logRates"/>
            </column>
        </log>
    </mcmc>

</beast>
